      allow list: if expalsaAdmin();
      allow create: if expalsaAdmin() && request.resource.data.keys().hasOnly(['uid','stage','keys','explanations']) && getAfter(workshopPath(id)).data.uid==request.resource.data.uid && getAfter(workshopPath(id)).data.stage==request.resource.data.stage && request.resource.data.keys.size()==10 && request.resource.data.explanations.size()==10;
      allow update,delete: if false;
    }
    function workshopSubmission(id,d) {return inspector() && d.keys().hasOnly(['uid','stage','answers','submittedAt']) && d.uid==request.auth.uid && get(workshopPath(id)).data.uid==request.auth.uid && d.stage==get(workshopPath(id)).data.stage && d.stage==activeStage(d.uid) && d.stage in [1,2,3] && d.answers is list && d.answers.size()==10 && d.answers.hasOnly([0,1,2,3]) && d.submittedAt==request.time && getAfter(/databases/$(database)/documents/expalsa_calidad_taller_resultados/$(id)).data.status=='submitted';}
    match /expalsa_calidad_taller_respuestas/{id} {
      allow get: if expalsaAdmin() || (inspector() && !exists(workshopAnswer(id)) && get(workshopPath(id)).data.uid==request.auth.uid);
      allow list: if expalsaAdmin();
      allow create: if workshopSubmission(id,request.resource.data);
      allow update,delete: if false;
    }
    match /expalsa_calidad_taller_borradores/{id} {
      allow get: if inspector() && get(workshopPath(id)).data.uid==request.auth.uid && get(workshopPath(id)).data.stage==activeStage(request.auth.uid) && !exists(workshopAnswer(id));
      allow create,update: if inspector() && request.resource.data.keys().hasOnly(['uid','stage','answers','clientUpdatedAt','status','updatedAt']) && request.resource.data.uid==request.auth.uid && get(workshopPath(id)).data.uid==request.auth.uid && request.resource.data.stage==get(workshopPath(id)).data.stage && request.resource.data.stage==activeStage(request.auth.uid) && request.resource.data.answers is list && request.resource.data.answers.size()==10 && request.resource.data.answers.hasOnly([-1,0,1,2,3]) && request.resource.data.clientUpdatedAt is int && request.resource.data.updatedAt==request.time && (request.resource.data.status=='draft' ? !exists(workshopAnswer(id)) : request.resource.data.status=='completed' && existsAfter(workshopAnswer(id)));
      allow list,delete: if false;
    }

    function workshopTotal(id) {let a=get(workshopAnswer(id)).data.answers;let k=get(/databases/$(database)/documents/expalsa_calidad_taller_claves/$(id)).data.keys;return (a[0]==k[0]?1:0) + (a[1]==k[1]?1:0) + (a[2]==k[2]?1:0) + (a[3]==k[3]?1:0) + (a[4]==k[4]?1:0) + (a[5]==k[5]?1:0) + (a[6]==k[6]?1:0) + (a[7]==k[7]?1:0) + (a[8]==k[8]?1:0) + (a[9]==k[9]?1:0);}
    function workshopMeta(id,d) {
      let w=getAfter(workshopPath(id)).data;
      return d.keys().hasAll(['uid','stage','target','trainingId','title','assignedAt','status','correctCount','points','submittedAt','gradedAt']) && d.keys().hasOnly(['uid','stage','target','trainingId','title','assignedAt','status','correctCount','points','submittedAt','gradedAt']) && d.uid==w.uid && d.stage==w.stage && d.target==w.target && d.trainingId==w.trainingId && d.title==w.title && d.assignedAt==w.assignedAt &&
       (d.status=='assigned' ? !existsAfter(workshopAnswer(id)) && d.correctCount==-1 && d.points==0 && d.submittedAt==null && d.gradedAt==null : existsAfter(workshopAnswer(id)) && d.submittedAt==getAfter(workshopAnswer(id)).data.submittedAt && (d.status=='submitted' ? d.correctCount==-1 && d.points==0 && d.gradedAt==null : d.status=='graded' && d.correctCount==workshopTotal(id) && d.points==(d.correctCount / 5.0) && d.gradedAt==request.time));
    }
    match /expalsa_calidad_taller_resultados/{id} {
      allow get,list: if expalsaAdmin() || (inspector() && resource.data.uid==request.auth.uid);
      allow create: if expalsaAdmin() && workshopMeta(id,request.resource.data);
      allow update: if workshopMeta(id,request.resource.data) && (expalsaAdmin() || (inspector() && resource.data.uid==request.auth.uid && ((resource.data.status=='assigned' && request.resource.data.status=='submitted') || (resource.data.status=='submitted' && request.resource.data.status=='graded'))));
      allow delete: if false;
    }
    match /expalsa_calidad_taller_puntuacion/{id}/comprobaciones/{count} {
      allow get: if inspector() && exists(workshopAnswer(id)) && get(workshopPath(id)).data.uid==request.auth.uid && count.matches('^[0-9]{1,2}$') && int(count)>=0 && int(count)<=workshopTotal(id);
      allow list,write: if false;
    }

    match /expalsa_calidad_fundamentos/{id} {
      allow get: if expalsaAdmin();
      allow create,update: if expalsaAdmin() && id=='historicos_v2' && request.resource.data.keys().hasOnly(['schema','questions','updatedAt']) && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt==request.time) && request.resource.data.schema==1 && request.resource.data.questions is map && request.resource.data.questions.size()==90;
      allow list,delete: if false;
    }
    match /expalsa_calidad_claves/{stage} {
      allow get,list: if expalsaAdmin();
      allow create: if expalsaAdmin() && publishedKeyValid(stage,request.resource.data);
      allow update,delete: if false;
    }
    match /expalsa_calidad_bancos/{version} {
      allow get: if expalsaAdmin() || (inspector() && resource.data.stage in [1,2,3] &&
        (dynamicBankReadable(request.auth.uid,stageName(resource.data.stage),version) || dynamicBankReadable(request.auth.uid,stageName(resource.data.stage)+'_2',version)));
      allow list: if expalsaAdmin();
      allow create: if expalsaAdmin() && dynamicBankValid(version,request.resource.data);
      allow update,delete: if false;
    }
    match /expalsa_calidad_soluciones/{version} {
      allow get,list: if expalsaAdmin();
      allow create: if expalsaAdmin() && dynamicKeyValid(version,request.resource.data);
      allow update,delete: if false;
    }
    match /expalsa_calidad_sesiones/{uid} {
      allow read,write: if false;
      match /etapas/{stage} {
        allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
        allow list: if expalsaAdmin();
        allow create: if inspector() && request.auth.uid==uid && photoPresent(uid) && identityPresent(uid) && validStage(stage,request.resource.data.stage) && stageDue(uid,stage) && bankAvailable(uid,stage) &&
          request.resource.data.keys().hasOnly(['uid','email','stage','startedAt','durationMinutes','status','checkedAt','bankSchema']) && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email &&
          request.resource.data.startedAt==request.time && request.resource.data.checkedAt==request.time && request.resource.data.status=='active' &&
          request.resource.data.durationMinutes==(retryStage(stage)?get(programDoc(uid)).data.retakes[baseStage(stage)].durationMinutes:get(programDoc(uid)).data.timeLimits[stage]) && limitValid(request.resource.data.durationMinutes) &&
          getAfter(attemptDoc(uid,stage)).data.status=='in_progress' && getAfter(attemptDoc(uid,stage)).data.startedAt==request.time && resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data);
        allow update: if (expalsaAdmin() || (inspector() && request.auth.uid==uid)) && identityStable() &&
          ((request.resource.data.status==resource.data.status && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedAt']) && request.resource.data.checkedAt==request.time) ||
           (resource.data.status=='active' && request.resource.data.status=='closed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            getAfter(attemptDoc(uid,stage)).data.status=='submitted' && resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data)));
        allow delete: if false;
      }
    }
    match /expalsa_calidad_resultados/{uid} {
      allow read,write: if false;
      match /etapas/{stage} {
        allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
        allow list: if expalsaAdmin();
        allow create,update: if (expalsaAdmin() || (inspector() && request.auth.uid==uid && request.resource.data.status in ['in_progress','submitted'])) &&
          validStage(stage,request.resource.data.stage) && resultMatches(uid,stage,request.resource.data);
        allow delete: if false;
      }
    }
    match /expalsa_calidad_etapas/{uid} {
      allow read,write: if false;
      match /entregas/{stage} {
        allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid && resource.data.status=='in_progress' && sessionOpen(uid,stage));
        allow list: if expalsaAdmin();
        
        allow create: if inspector() && request.auth.uid==uid && photoPresent(uid) && identityPresent(uid) &&
          validStage(stage,request.resource.data.stage) && stageDue(uid,stage) &&
          request.resource.data.keys().hasOnly(['uid','email','stage','startedAt','durationMinutes','status','version','answers','bankSchema']) && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email &&
          request.resource.data.status=='in_progress' && request.resource.data.startedAt==request.time && initialBankValid(request.resource.data,stage) &&
          getAfter(sessionDoc(uid,stage)).data.status=='active' && getAfter(sessionDoc(uid,stage)).data.startedAt==request.time && request.resource.data.durationMinutes==getAfter(sessionDoc(uid,stage)).data.durationMinutes &&
          resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data);
        allow update: if expalsaAdmin() ? (expiredDelivery(uid,stage) || gradedDelivery(uid,stage)) :
          (inspector() && request.auth.uid==uid && resource.data.status=='in_progress' &&
          ((sessionOpen(uid,stage) && request.resource.data.status=='in_progress' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','version']) &&
            attemptAnswersValid(stage,-1)) ||
           (sessionOpen(uid,stage) && finalDelivery(uid,stage) && request.resource.data.submissionKind=='manual' && attemptAnswersValid(stage,0)) ||
           expiredDelivery(uid,stage)));
        allow delete: if false;
      }
    }
function emAdmin() {
  return expalsaAdmin();
}
function emJefe(uid) {
  return exists(/databases/$(database)/documents/empaque_ejercicio_jefes/$(uid))
    && get(/databases/$(database)/documents/empaque_ejercicio_jefes/$(uid)).data.activo == true;
}
function emUsuario() {
  return accountEmail() &&
    request.auth.token.email.matches('^[^@]+@expalsaevaluations[.]com$') &&
    (emAdmin() || inspector() || emJefe(request.auth.uid));
}
function emLeeReporte(r) {
  return emUsuario() && (r.owner == request.auth.uid || emAdmin() || emJefe(request.auth.uid));
}
function emEditaReporte(r) {
  return emUsuario() && (r.owner == request.auth.uid || emAdmin());
}
match /empaque_ejercicio_jefes/{uid} {
  allow get: if emUsuario();
  allow list: if emAdmin();
  allow create, update: if emAdmin()
    && request.resource.data.keys().hasOnly(['nombre', 'activo'])
    && request.resource.data.nombre is string
    && request.resource.data.activo is bool;
  allow delete: if false;
}
match /empaque_ejercicio_qr/{token} {
  allow get: if emUsuario();
  allow list: if false;
  allow create: if emUsuario()
    && (emAdmin() || request.resource.data.uid == request.auth.uid)
    && emJefe(request.resource.data.uid)
    && token.matches('[a-f0-9]{64}')
    && request.resource.data.keys().hasOnly(['uid', 'activo', 'vence', 'creado'])
    && request.resource.data.activo == true
    && request.resource.data.creado == request.time
    && request.resource.data.vence > request.time
    && request.resource.data.vence <= request.time + duration.value(9, 'h');
  allow update, delete: if false;
}
match /empaque_ejercicio_ordenes/{id} {
  allow read: if emUsuario();
  allow create, update: if emAdmin();
}
match /empaque_ejercicio_materias/{id} {
  allow read: if emUsuario();
  allow create, update: if emAdmin();
}
match /empaque_ejercicio_residuales/{id} {
  allow read: if emUsuario();
  allow create, update: if emAdmin();
}
match /empaque_ejercicio_config/contador {
  allow read: if emUsuario();
  allow create: if emUsuario() && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == 1;
  allow update: if emUsuario() && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == resource.data.ultimo + 1;
}
match /empaque_ejercicio_reportes/{reporteId} {
  function baseActualizacion() {
    return emEditaReporte(resource.data)
      && resource.data.estado == 'abierto'
      && resource.data.eliminado == false
      && request.resource.data.owner == resource.data.owner
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.actualizado == request.time;
  }
  function edicion() {
    return request.resource.data.ultima.tipo == 'editar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muestras','alertas','pendientes','revision','actualizado','ultima'])
      && request.resource.data.muestras is list
      && request.resource.data.muestras.size() <= 12
      && request.resource.data.alertas is map
      && request.resource.data.pendientes is list
      && request.resource.data.pendientes.toSet().hasAll(resource.data.pendientes.toSet())
      && request.resource.data.alertas.diff(resource.data.alertas).changedKeys().size() == 0
      && request.resource.data.alertas.diff(resource.data.alertas).removedKeys().size() == 0
      && request.resource.data.alertas.diff(resource.data.alertas).addedKeys() == request.resource.data.pendientes.toSet().difference(resource.data.pendientes.toSet());
  }
  function autoriza() {
    let id = request.resource.data.ultima.alertaId;
    let hash = request.resource.data.ultima.tokenHash;
    let token = get(/databases/$(database)/documents/empaque_ejercicio_qr/$(hash)).data;
    let jefe = get(/databases/$(database)/documents/empaque_ejercicio_jefes/$(token.uid)).data;
    let aprobacion = request.resource.data.alertas[id].autorizacion;
    return request.resource.data.ultima.tipo == 'autorizar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alertas','pendientes','revision','actualizado','ultima'])
      && id in resource.data.pendientes
      && token.activo == true && token.vence > request.time && jefe.activo == true
      && request.resource.data.pendientes == resource.data.pendientes.removeAll([id])
      && request.resource.data.alertas.diff(resource.data.alertas).affectedKeys().hasOnly([id])
      && request.resource.data.alertas[id].diff(resource.data.alertas[id]).affectedKeys().hasOnly(['autorizacion'])
      && aprobacion.keys().hasOnly(['nombre','uid','tokenHash','fecha','registradoPor'])
      && aprobacion.nombre == jefe.nombre
      && aprobacion.uid == token.uid
      && aprobacion.tokenHash == hash
      && aprobacion.registradoPor == request.auth.uid;
  }
  function cierra() {
    return request.resource.data.ultima.tipo == 'cerrar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','cerrado','revision','actualizado','ultima'])
      && request.resource.data.estado == 'cerrado'
      && request.resource.data.cerrado == request.time
      && resource.data.pendientes.size() == 0
      && resource.data.muestras.size() > 0;
  }
  function elimina() {
    return request.resource.data.ultima.tipo == 'eliminar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eliminado','revision','actualizado','ultima'])
      && request.resource.data.eliminado == true;
  }
  allow read: if emLeeReporte(resource.data);
  allow create: if emUsuario()
    && request.resource.data.owner == request.auth.uid
    && request.resource.data.estado == 'abierto'
    && request.resource.data.muestras == []
    && request.resource.data.alertas == {}
    && request.resource.data.pendientes == []
    && request.resource.data.revision == 0
    && request.resource.data.eliminado == false
    && request.resource.data.creado == request.time;
  allow update: if baseActualizacion() && (
    (request.resource.data.ultima.tipo == 'editar' && edicion())
    || (request.resource.data.ultima.tipo == 'autorizar' && autoriza())
    || (request.resource.data.ultima.tipo == 'cerrar' && cierra())
    || (request.resource.data.ultima.tipo == 'eliminar' && elimina())
  );
  allow delete: if false;
  match /fotos/{fotoId} {
    allow read: if emLeeReporte(get(/databases/$(database)/documents/empaque_ejercicio_reportes/$(reporteId)).data);
    allow create: if emEditaReporte(get(/databases/$(database)/documents/empaque_ejercicio_reportes/$(reporteId)).data)
      && get(/databases/$(database)/documents/empaque_ejercicio_reportes/$(reporteId)).data.estado == 'abierto'
      && request.resource.data.owner == request.auth.uid
      && request.resource.data.creado == request.time
      && request.resource.data.imagen is string
      && request.resource.data.imagen.size() <= 300000
      && request.resource.data.imagen.matches('data:image/jpeg;base64,.*');
    allow update, delete: if false;
  }
}



    // MODULO DE CAPACITACION 2026 - EXCLUSIVAMENTE ADMINISTRADOR
    // Colecciones independientes: no modifica evaluaciones, resultados ni expedientes oficiales.
    function capAdminWrite(d) {
      return expalsaAdmin()
        && d.keys().hasOnly(['id','name','station','accountUid','email','active','createdAt','updatedAt','updatedBy'])
        && d.keys().hasAll(['id','name','station','accountUid','email','active','createdAt','updatedAt','updatedBy'])
        && d.id is string && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.station in ['M02','M05','M06','M07','M08','M09','M10','B12','B345','T01']
        && d.email is string && d.email.size() <= 150
        && d.accountUid is string && d.accountUid.size() <= 128
        && d.active is bool
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function capBoardScore(v) { return v == null || (v is number && v >= 0 && v <= 100); }
    function capBoardScoresValid(s) { return s is list && s.size() == 10
      && capBoardScore(s[0]) && capBoardScore(s[1]) && capBoardScore(s[2]) && capBoardScore(s[3]) && capBoardScore(s[4])
      && capBoardScore(s[5]) && capBoardScore(s[6]) && capBoardScore(s[7]) && capBoardScore(s[8]) && capBoardScore(s[9]); }
    function capBoardRowValid(r) { return r is map && r.keys().hasOnly(['name','scores']) && r.keys().hasAll(['name','scores'])
      && r.name is string && r.name.size() >= 1 && r.name.size() <= 100 && capBoardScoresValid(r.scores); }
    function capBoardRowsValid(rows) { return rows is list && rows.size() <= 10
      && (rows.size() < 1 || capBoardRowValid(rows[0])) && (rows.size() < 2 || capBoardRowValid(rows[1]))
      && (rows.size() < 3 || capBoardRowValid(rows[2])) && (rows.size() < 4 || capBoardRowValid(rows[3]))
      && (rows.size() < 5 || capBoardRowValid(rows[4])) && (rows.size() < 6 || capBoardRowValid(rows[5]))
      && (rows.size() < 7 || capBoardRowValid(rows[6])) && (rows.size() < 8 || capBoardRowValid(rows[7]))
      && (rows.size() < 9 || capBoardRowValid(rows[8])) && (rows.size() < 10 || capBoardRowValid(rows[9])); }
    match /expalsa_calidad_capacitacion_tablero/{recordId} {
      allow get: if recordId == 'cohorte_actual' && (expalsaAdmin() || inspector());
      allow list, delete: if false;
      allow create, update: if recordId == 'cohorte_actual' && expalsaAdmin()
        && request.resource.data.keys().hasOnly(['schema','inspectors','updatedAt'])
        && request.resource.data.keys().hasAll(['schema','inspectors','updatedAt'])
        && request.resource.data.schema == 1 && capBoardRowsValid(request.resource.data.inspectors)
        && request.resource.data.updatedAt == request.time;
    }
    match /expalsa_capacitacion_2026_participantes/{participantId} {
      allow get, list: if expalsaAdmin();
      // Membership changes go through manageTrainingGroups, which validates
      // identity across every group in a serialized server transaction.
      // groupNumber is a positive group number; absent means legacy Group 1.
      allow create, update, delete: if false;
    }
    match /expalsa_capacitacion_2026_grupos/{groupId} {
      // Server-only metadata: number, name, jpeg, rev and audit timestamps.
      // One responsible per group; participant references exactly one number.
      allow read, write: if false;
    }
    function capParticipantActive(personId) {
      let p = get(/databases/$(database)/documents/expalsa_capacitacion_2026_participantes/$(personId)).data;
      return p.active == true && p.get('deleted', false) != true;
    }
    function capSessionValid(d, sid) {
      return expalsaAdmin() && capParticipantActive(d.personId)
        && d.keys().hasOnly(['id','personId','personName','station','day','date','minutes','attendance','ratings','notes','followup','followupResolved','evidenceImage','status','rev','createdAt','updatedAt','updatedBy'])
        && d.keys().hasAll(['id','personId','personName','station','day','date','minutes','attendance','ratings','notes','followup','followupResolved','evidenceImage','status','rev','createdAt','updatedAt','updatedBy'])
        && d.id == sid && d.personId is string && d.personId.size() <= 70
        && d.personName is string && d.personName.size() <= 100
        && d.station in ['M02','M05','M06','M07','M08','M09','M10','B12','B345','T01']
        && d.day is int && d.day >= 1 && d.day <= 10
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.minutes is int && d.minutes >= 0 && d.minutes <= 480
        && d.attendance in ['asistio','no_asistio','reprogramado']
        && d.ratings is map && d.ratings.size() <= 10
        && d.notes is string && d.notes.size() <= 8000
        && d.followup is string && d.followup.size() <= 3000
        && d.followupResolved is bool
        && d.evidenceImage is string && d.evidenceImage.size() <= 145000
        && (d.evidenceImage == '' || d.evidenceImage.matches('data:image/jpeg;base64,.*'))
        && d.status in ['draft','done']
        && d.rev is int && d.rev >= 1
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /expalsa_capacitacion_2026_sesiones/{sessionId} {
      allow get, list: if expalsaAdmin();
      allow create: if capSessionValid(request.resource.data, sessionId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.rev == 1
        && exists(/databases/$(database)/documents/expalsa_capacitacion_2026_participantes/$(request.resource.data.personId));
      allow update: if capSessionValid(request.resource.data, sessionId)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.id == resource.data.id
        && request.resource.data.personId == resource.data.personId
        && request.resource.data.day == resource.data.day
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /fotos/{photoId} {
        allow get, list: if expalsaAdmin();
        allow create: if expalsaAdmin()
          && capParticipantActive(get(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId)).data.personId)
          && photoId.matches('^FT_[A-Za-z0-9]{12,64}$')
          && exists(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId))
          && get(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId)).data.status == 'draft'
          && request.resource.data.keys().hasOnly(['sessionId','personId','day','jpeg','width','height','size','origin','criterionId','createdBy','createdAt'])
          && request.resource.data.keys().hasAll(['sessionId','personId','day','jpeg','width','height','size','origin','createdBy','createdAt'])
          && request.resource.data.sessionId == sessionId
          && request.resource.data.personId == get(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId)).data.personId
          && request.resource.data.day == get(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId)).data.day
          && request.resource.data.jpeg is string
          && request.resource.data.jpeg.size() <= 175000
          && request.resource.data.jpeg.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.width is int && request.resource.data.width >= 1 && request.resource.data.width <= 960
          && request.resource.data.height is int && request.resource.data.height >= 1 && request.resource.data.height <= 960
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 132000
          && request.resource.data.origin in ['camera','gallery']
          && (!request.resource.data.keys().hasAny(['criterionId'])
              || (request.resource.data.criterionId is string
                  && (request.resource.data.criterionId == '' || request.resource.data.criterionId.matches('^D(10|[1-9])_[1-4]$'))))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if expalsaAdmin()
          && exists(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId))
          && get(/databases/$(database)/documents/expalsa_capacitacion_2026_sesiones/$(sessionId)).data.status == 'draft';
      }
    }


    // Seguimiento del plan firmado 6.1 y 6.2. Solo administrador.
    // Modelo: id y type inmutables; payload tipado por formulario; revision incremental.
    // No elimina ni modifica las reglas de los modulos existentes.
    match /expalsa_capacitacion_2026_documentos/{docId} {
      allow get: if expalsaAdmin();
      allow list, write: if false;
    }
    function capComplementPayload(d) {
      return d.payload is map && d.payload.status in ['draft','done'] && (
        (d.type == 'periodo' && d.payload.keys().hasAll(["programStart","reviewedBy","evidence","status"]) && d.payload.keys().hasOnly(["programStart","reviewedBy","evidence","status"])
          && d.payload.programStart is string && d.payload.programStart.size() <= 3000
          && d.payload.reviewedBy is string && d.payload.reviewedBy.size() <= 3000
          && d.payload.evidence is string && d.payload.evidence.size() <= 3000
          && d.id == 'cp_periodo_2026' && d.payload.programStart.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.payload.reviewedBy.size() > 0 && d.payload.evidence.size() > 0
          && (d.payload.status != 'done' || (d.payload.programStart.size() > 0 && d.payload.reviewedBy.size() > 0 && d.payload.evidence.size() > 0))) ||
        (d.type == 'calibracion' && d.payload.keys().hasAll(["date","minutes","sample","spec","lead","shiftLead","reference","tolerance","validatedBy","agreements","evidence","status"]) && d.payload.keys().hasOnly(["date","minutes","sample","spec","lead","shiftLead","reference","tolerance","validatedBy","agreements","evidence","status"])
          && d.payload.date is string && d.payload.date.size() <= 3000
          && d.payload.minutes is string && d.payload.minutes.size() <= 3000
          && d.payload.sample is string && d.payload.sample.size() <= 3000
          && d.payload.spec is string && d.payload.spec.size() <= 3000
          && d.payload.lead is string && d.payload.lead.size() <= 3000
          && d.payload.shiftLead is string && d.payload.shiftLead.size() <= 3000
          && d.payload.reference is string && d.payload.reference.size() <= 3000
          && d.payload.tolerance is string && d.payload.tolerance.size() <= 3000
          && d.payload.validatedBy is string && d.payload.validatedBy.size() <= 3000
          && d.payload.agreements is string && d.payload.agreements.size() <= 3000
          && d.payload.evidence is string && d.payload.evidence.size() <= 3000
          && (d.payload.status != 'done' || (d.payload.date.size() > 0 && d.payload.minutes.size() > 0 && d.payload.sample.size() > 0 && d.payload.spec.size() > 0 && d.payload.lead.size() > 0 && d.payload.shiftLead.size() > 0 && d.payload.reference.size() > 0 && d.payload.tolerance.size() > 0 && d.payload.validatedBy.size() > 0 && d.payload.agreements.size() > 0 && d.payload.evidence.size() > 0))) ||
        (d.type == 'resultado' && d.payload.keys().hasAll(["calibrationId","personId","attendance","talla","cuenta","uniformidad","defectos","decision","discrepancy","reinforcement","recheck","concordant","evidence","status"]) && d.payload.keys().hasOnly(["calibrationId","personId","attendance","talla","cuenta","uniformidad","defectos","decision","discrepancy","reinforcement","recheck","concordant","evidence","status"])
          && d.payload.calibrationId is string && d.payload.calibrationId.size() <= 3000
          && d.payload.personId is string && d.payload.personId.size() <= 3000
          && d.payload.attendance is string && d.payload.attendance.size() <= 3000
          && d.payload.talla is string && d.payload.talla.size() <= 3000
          && d.payload.cuenta is string && d.payload.cuenta.size() <= 3000
          && d.payload.uniformidad is string && d.payload.uniformidad.size() <= 3000
          && d.payload.defectos is string && d.payload.defectos.size() <= 3000
          && d.payload.decision is string && d.payload.decision.size() <= 3000
          && d.payload.discrepancy is string && d.payload.discrepancy.size() <= 3000
          && d.payload.reinforcement is string && d.payload.reinforcement.size() <= 3000
          && d.payload.recheck is string && d.payload.recheck.size() <= 3000
          && d.payload.concordant is string && d.payload.concordant.size() <= 3000
          && d.payload.evidence is string && d.payload.evidence.size() <= 3000
          && capParticipantActive(d.payload.personId)
          && d.id == 'cp_res_' + d.payload.calibrationId + '_' + d.payload.personId
          && get(/databases/$(database)/documents/expalsa_capacitacion_2026_complementos/$(d.payload.calibrationId)).data.type == 'calibracion'
          && d.payload.attendance in ['','asistio','no_asistio','reprogramado'] && d.payload.concordant in ['','si','no']
          && d.payload.decision in ['','aceptar','rechazar']
          && (d.payload.status != 'done' || (d.payload.attendance == 'asistio' && d.payload.concordant == 'si'
            && get(/databases/$(database)/documents/expalsa_capacitacion_2026_complementos/$(d.payload.calibrationId)).data.payload.status == 'done'
            && (d.payload.discrepancy == '' || (d.payload.reinforcement.size() > 0 && d.payload.recheck.size() > 0))))
          && (d.payload.status != 'done' || (d.payload.calibrationId.size() > 0 && d.payload.personId.size() > 0 && d.payload.attendance.size() > 0 && d.payload.talla.size() > 0 && d.payload.cuenta.size() > 0 && d.payload.uniformidad.size() > 0 && d.payload.defectos.size() > 0 && d.payload.decision.size() > 0 && d.payload.concordant.size() > 0 && d.payload.evidence.size() > 0))) ||
        (d.type == 'reclamo' && d.payload.keys().hasAll(["code","date","product","deviation","requirement","cause","control","action","topic","competency","day","priority","rationale","evidence","status"]) && d.payload.keys().hasOnly(["code","date","product","deviation","requirement","cause","control","action","topic","competency","day","priority","rationale","evidence","status"])
          && d.payload.code is string && d.payload.code.size() <= 3000
          && d.payload.date is string && d.payload.date.size() <= 3000
          && d.payload.product is string && d.payload.product.size() <= 3000
          && d.payload.deviation is string && d.payload.deviation.size() <= 3000
          && d.payload.requirement is string && d.payload.requirement.size() <= 3000
          && d.payload.cause is string && d.payload.cause.size() <= 3000
          && d.payload.control is string && d.payload.control.size() <= 3000
          && d.payload.action is string && d.payload.action.size() <= 3000
          && d.payload.topic is string && d.payload.topic.size() <= 3000
          && d.payload.competency is string && d.payload.competency.size() <= 3000
          && d.payload.day is string && d.payload.day.size() <= 3000
          && d.payload.priority is string && d.payload.priority.size() <= 3000
          && d.payload.rationale is string && d.payload.rationale.size() <= 3000
          && d.payload.evidence is string && d.payload.evidence.size() <= 3000
          && exists(/databases/$(database)/documents/expalsa_capacitacion_2026_complementos/cp_periodo_2026)
          && d.payload.day in ['','2','3','4','5','6','8','9'] && d.payload.priority in ['','alta','media','baja']
          && (d.payload.status != 'done' || (d.payload.code.size() > 0 && d.payload.date.size() > 0 && d.payload.product.size() > 0 && d.payload.deviation.size() > 0 && d.payload.requirement.size() > 0 && d.payload.cause.size() > 0 && d.payload.control.size() > 0 && d.payload.action.size() > 0 && d.payload.topic.size() > 0 && d.payload.competency.size() > 0 && d.payload.day.size() > 0 && d.payload.priority.size() > 0 && d.payload.rationale.size() > 0 && d.payload.evidence.size() > 0))) ||
        (d.type == 'aprendizaje' && d.payload.keys().hasAll(["caseId","personId","date","explanation","requirement","detection","containment","communication","verification","result","reinforcement","resolved","evidence","status"]) && d.payload.keys().hasOnly(["caseId","personId","date","explanation","requirement","detection","containment","communication","verification","result","reinforcement","resolved","evidence","status"])
          && d.payload.caseId is string && d.payload.caseId.size() <= 3000
          && d.payload.personId is string && d.payload.personId.size() <= 3000
          && d.payload.date is string && d.payload.date.size() <= 3000
          && d.payload.explanation is string && d.payload.explanation.size() <= 3000
          && d.payload.requirement is string && d.payload.requirement.size() <= 3000
          && d.payload.detection is string && d.payload.detection.size() <= 3000
          && d.payload.containment is string && d.payload.containment.size() <= 3000
          && d.payload.communication is string && d.payload.communication.size() <= 3000
          && d.payload.verification is string && d.payload.verification.size() <= 3000
          && d.payload.result is string && d.payload.result.size() <= 3000
          && d.payload.reinforcement is string && d.payload.reinforcement.size() <= 3000
          && d.payload.resolved is string && d.payload.resolved.size() <= 3000
          && d.payload.evidence is string && d.payload.evidence.size() <= 3000
          && capParticipantActive(d.payload.personId)
          && d.id == 'cp_apr_' + d.payload.caseId + '_' + d.payload.personId
          && get(/databases/$(database)/documents/expalsa_capacitacion_2026_complementos/$(d.payload.caseId)).data.type == 'reclamo'
          && d.payload.result in ['','demostrado','refuerzo'] && d.payload.resolved in ['','si','no']
          && (d.payload.status != 'done' || (d.payload.result == 'demostrado' && (d.payload.reinforcement == '' || d.payload.resolved == 'si')))
          && (d.payload.status != 'done' || (d.payload.caseId.size() > 0 && d.payload.personId.size() > 0 && d.payload.date.size() > 0 && d.payload.explanation.size() > 0 && d.payload.requirement.size() > 0 && d.payload.detection.size() > 0 && d.payload.containment.size() > 0 && d.payload.communication.size() > 0 && d.payload.verification.size() > 0 && d.payload.result.size() > 0 && d.payload.resolved.size() > 0 && d.payload.evidence.size() > 0)))
      );
    }
    function capComplementValid(d, id) {
      return expalsaAdmin()
        && d.keys().hasAll(['id','type','payload','rev','createdAt','updatedAt','updatedBy'])
        && d.keys().hasOnly(['id','type','payload','rev','createdAt','updatedAt','updatedBy'])
        && d.id == id && id.matches('cp_[A-Za-z0-9_]{8,200}')
        && d.rev is int && d.rev >= 1
        && d.createdAt is timestamp && d.updatedAt == request.time && d.updatedBy == request.auth.uid
        && capComplementPayload(d);
    }
    match /expalsa_capacitacion_2026_complementos/{id} {
      allow get, list: if expalsaAdmin();
      allow create: if capComplementValid(request.resource.data, id)
        && request.resource.data.rev == 1 && request.resource.data.createdAt == request.time;
      allow update: if capComplementValid(request.resource.data, id)
        && request.resource.data.id == resource.data.id && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if false;
    }

    // Responsable del equipo actual: nombre y fotografia opcional, solo administrador.
    // No altera participantes, dias, horas ni resultados de capacitacion.
    function capResponsibleValid(d) {
      return expalsaAdmin()
        && d.keys().hasAll(['name','jpeg','rev','createdAt','updatedAt','updatedBy'])
        && d.keys().hasOnly(['name','jpeg','rev','createdAt','updatedAt','updatedBy'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.jpeg is string && d.jpeg.size() <= 170000
        && (d.jpeg == '' || d.jpeg.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && d.rev is int && d.rev >= 1 && d.createdAt is timestamp
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /expalsa_capacitacion_2026_equipo/{recordId} {
      allow get: if expalsaAdmin() && recordId == 'responsable';
      allow list, delete: if false;
      allow create: if recordId == 'responsable' && capResponsibleValid(request.resource.data)
        && request.resource.data.rev == 1 && request.resource.data.createdAt == request.time;
      allow update: if recordId == 'responsable' && capResponsibleValid(request.resource.data)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Evaluacion propia del plan 2026. Banco privado e inmutable desde el cliente.
    // Intentos: identidad/alcance/banco/inicio inmutables. Respuestas JSON <=60000.
    // Marcas JSON <=1500, revision incremental, entrega y calificacion irreversibles.
    match /expalsa_capacitacion_2026_bancos/{version} {
      allow get: if expalsaAdmin();
      allow list, create, update, delete: if false;
    }
    function capExamValid(d,id) {
      return expalsaAdmin()
        && d.keys().hasAll(['id','accountUid','scope','purpose','durationMinutes','bankId','status','answers','marks','startedAt','createdAt','updatedAt','submittedAt','gradedAt','submissionKind','createdBy','updatedBy','rev'])
        && d.keys().hasOnly(['id','accountUid','scope','purpose','durationMinutes','bankId','status','answers','marks','startedAt','createdAt','updatedAt','submittedAt','gradedAt','submissionKind','createdBy','updatedBy','rev'])
        && d.id==id && id.matches('^[A-Za-z0-9]{20}$')
        && d.accountUid is string && d.accountUid.size()>0 && d.accountUid.size()<=128
        && d.scope is int && d.scope>=0 && d.scope<=10
        && d.purpose in ['inicial','final','refuerzo']
        && d.durationMinutes is int && d.durationMinutes>=5 && d.durationMinutes<=180
        && d.bankId=='cap-plan-20261103-v1'
        && exists(/databases/$(database)/documents/expalsa_capacitacion_2026_bancos/$(d.bankId))
        && d.status in ['active','submitted','graded']
        && d.answers is string && d.answers.size()>=2 && d.answers.size()<=60000
        && d.marks is string && d.marks.size()>=2 && d.marks.size()<=1500
        && d.startedAt is timestamp && d.createdAt is timestamp && d.updatedAt==request.time
        && d.createdBy is string && d.createdBy.size()>0 && d.createdBy.size()<=128
        && d.updatedBy==request.auth.uid && d.rev is int && d.rev>=1
        && ((d.status=='active' && d.submittedAt==null && d.gradedAt==null && d.submissionKind=='' && d.marks=='{}') ||
          (d.status in ['submitted','graded'] && d.submittedAt is timestamp && d.submissionKind in ['manual','expired'] &&
          ((d.status=='submitted' && d.gradedAt==null && d.marks=='{}') || (d.status=='graded' && d.gradedAt is timestamp))));
    }
    function capExamIdentityStable(d,a) {
      return d.id==a.id && d.accountUid==a.accountUid && d.scope==a.scope && d.purpose==a.purpose
        && d.durationMinutes==a.durationMinutes && d.bankId==a.bankId && d.startedAt==a.startedAt
        && d.createdAt==a.createdAt && d.createdBy==a.createdBy && d.rev==a.rev+1;
    }
    function capExamUpdate(d,a) {
      let deadline=a.startedAt+duration.value(a.durationMinutes*60,'s');
      return capExamIdentityStable(d,a) && (
        (a.status=='active' && d.status=='active' && request.time<deadline
          && d.diff(a).affectedKeys().hasOnly(['answers','rev','updatedAt','updatedBy'])) ||
        (a.status=='active' && d.status=='submitted' && d.answers==a.answers && d.submittedAt==request.time
          && (d.submissionKind=='expired'?request.time>=deadline:request.time<deadline)
          && d.diff(a).affectedKeys().hasOnly(['status','submittedAt','submissionKind','rev','updatedAt','updatedBy'])) ||
        (a.status=='submitted' && d.status=='graded' && d.answers==a.answers && d.submittedAt==a.submittedAt && d.submissionKind==a.submissionKind
          && d.gradedAt==request.time
          && d.diff(a).affectedKeys().hasOnly(['status','marks','gradedAt','rev','updatedAt','updatedBy']))
      );
    }
    match /expalsa_capacitacion_2026_evaluaciones/{id} {
      allow get, list: if expalsaAdmin();
      allow create: if capExamValid(request.resource.data,id)
        && request.resource.data.rev==1 && request.resource.data.status=='active'
        && request.resource.data.answers=='{}' && request.resource.data.marks=='{}'
        && request.resource.data.startedAt==request.time && request.resource.data.createdAt==request.time
        && request.resource.data.createdBy==request.auth.uid
        && exists(accessDoc(request.resource.data.accountUid))
        && get(accessDoc(request.resource.data.accountUid)).data.active==true
        && get(accessDoc(request.resource.data.accountUid)).data.get('deleted',false)!=true;
      allow update: if capExamValid(request.resource.data,id) && capExamUpdate(request.resource.data,resource.data);
      allow delete: if false;
    }

    // Mapa de calidad y sabor: isolated from every other repository collection.
    match /grados/{id} {
      allow get, list: if calidadPageUser();
      allow create, update: if calidadPageUser() && calidadPageAdmin() && validCalidadGrade(request.resource.data);
      allow delete: if calidadPageUser() && calidadPageAdmin();
    }
    match /destinos/{id} {
      allow get, list: if calidadPageUser();
      allow create, update: if calidadPageUser() && calidadPageAdmin() && validCalidadDestination(request.resource.data);
      allow delete: if calidadPageUser() && calidadPageAdmin();
    }
    match /clientes_calidad/{clientId} {
      allow get, list: if calidadPageUser();
      allow create, update: if calidadPageUser() && calidadPageAdmin() && validCalidadClient(request.resource.data);
      allow delete: if calidadPageUser() && calidadPageAdmin();
    }
    match /fichas_tecnicas_calidad/{id} {
      allow get, list: if calidadPageUser();
      allow create, update: if calidadPageUser() && calidadPageAdmin() && validFichaTecnica(request.resource.data, id);
      allow delete: if calidadPageUser() && calidadPageAdmin();
    }


    // Inspection module: isolated records for facilities reports; existing maps,
    // training, access control and quality collections keep their own rules.
    function expalsaInspectionUser() { return expalsaAdmin() || inspector(); }
    function expalsaInspectionPhotoValid(photo) {
      return photo is map && photo.keys().hasAll(['path','name','uploadedBy','origin'])
        && photo.keys().hasOnly(['path','name','uploadedBy','origin'])
        && photo.uploadedBy is string && photo.uploadedBy.size() >= 20 && photo.uploadedBy.size() <= 128
        && photo.uploadedBy.matches('^[A-Za-z0-9_-]+')
        && photo.name is string && photo.name.size() > 0 && photo.name.size() <= 120
        && photo.origin in ['camera','gallery'] && photo.path is string && photo.path.size() == 83 + photo.uploadedBy.size()
        && photo.path.matches('^expalsa_inspecciones/' + photo.uploadedBy + '/[A-Za-z0-9_-]{20}/[A-Fa-f0-9-]{36}[.]jpg');
    }
    function expalsaInspectionPhotosValid(photos) {
      return photos is list && photos.size() <= 6
        && (photos.size() < 1 || expalsaInspectionPhotoValid(photos[0]))
        && (photos.size() < 2 || expalsaInspectionPhotoValid(photos[1]))
        && (photos.size() < 3 || expalsaInspectionPhotoValid(photos[2]))
        && (photos.size() < 4 || expalsaInspectionPhotoValid(photos[3]))
        && (photos.size() < 5 || expalsaInspectionPhotoValid(photos[4]))
        && (photos.size() < 6 || expalsaInspectionPhotoValid(photos[5]));
    }
    function expalsaInspectionRecordValid(d, id) {
      return id.size() == 20 && id.matches('^[A-Za-z0-9]+')
        && d.keys().hasAll(['area','inspectedAt','location','description','department','notificationDate','status','notes','photos','inspectorName','inspectorEmail','inspectorUid','createdBy','createdAt','updatedBy','updatedAt','source'])
        && d.keys().hasOnly(['area','inspectedAt','location','description','department','notificationDate','status','notes','photos','inspectorName','inspectorEmail','inspectorUid','createdBy','createdAt','updatedBy','updatedAt','source'])
        && d.area in ['PLANTA','EXTERIORES','BODEGAS','DESECHOS','DESPACHO','OTROS']
        && d.inspectedAt is string && d.inspectedAt.size() == 10 && d.inspectedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.location is string && d.location.size() > 0 && d.location.size() <= 160
        && d.description is string && d.description.size() > 0 && d.description.size() <= 1800
        && d.department is string && d.department.size() > 0 && d.department.size() <= 100
        && d.notificationDate is string && (d.notificationDate == '' || (d.notificationDate.size() == 10 && d.notificationDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && d.status in ['cumple','no_cumple','parcial','nueva']
        && d.notes is string && d.notes.size() <= 1200 && expalsaInspectionPhotosValid(d.photos)
        && d.inspectorName is string && d.inspectorName.size() > 0 && d.inspectorName.size() <= 120
        && d.inspectorEmail is string && d.inspectorEmail.matches('^[^@]+@[^@]+$')
        && d.inspectorUid is string && d.inspectorUid.size() > 0 && d.inspectorUid.size() <= 128
        && d.createdBy is string && d.createdBy.size() > 0 && d.createdBy.size() <= 128
        && d.createdAt is timestamp && d.updatedBy == request.auth.uid && d.updatedAt == request.time
        && d.source in ['app','pdf_import'];
    }
    match /expalsa_calidad_inspecciones/{id} {
      allow get, list: if expalsaInspectionUser();
      allow create: if expalsaInspectionUser() && expalsaInspectionRecordValid(request.resource.data, id)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inspectorUid == request.auth.uid
        && request.resource.data.inspectorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if expalsaInspectionUser() && expalsaInspectionRecordValid(request.resource.data, id)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.inspectorUid == resource.data.inspectorUid
        && request.resource.data.inspectorEmail == resource.data.inspectorEmail
        && request.resource.data.inspectorName == resource.data.inspectorName;
      allow delete: if expalsaAdmin();
    }

  }
}

