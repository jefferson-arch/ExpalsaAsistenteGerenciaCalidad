    }

    function retryEligible(uid,stage) {
      let a=get(attemptDoc(uid,stage)).data;
      let automatic=exists(automaticResultDoc(uid,stage));
      let grade=automatic?get(automaticResultDoc(uid,stage)).data:{'correctCount':0,'total':1};
      let score=automatic?(grade.correctCount * 100.0 / grade.total):a.get('score',-1);
      return a.status in ['submitted','graded'] && (automatic || a.status=='graded') && score>=40 && score<60;
    }
    function retakeGrantValid(uid,stage,grants,old) {
      let g=grants.get(stage,{});
      return g==old.get(stage,{}) ||
        (!old.keys().hasAny([stage]) && g is map && g.keys().hasOnly(['enabled','durationMinutes','version','authorizedAt','authorizedBy']) &&
         g.keys().hasAll(['enabled','durationMinutes','version','authorizedAt','authorizedBy']) && g.enabled==true && limitValid(g.durationMinutes) &&
         g.authorizedAt==request.time && g.authorizedBy==request.auth.uid && g.version==assignedVersion(uid,stage+'_2',get(evaluationConfig()).data.versions[stage]) &&
         get(evaluationConfig()).data.schema==3 && activeStage(uid)==stageNumber(stage) && retryEligible(uid,stage) &&
         !exists(sessionDoc(uid,stage+'_2')) && !exists(attemptDoc(uid,stage+'_2')) && !exists(resultDoc(uid,stage+'_2')));
    }
    function retakesValid(uid,d,old) {
      let grants=d.get('retakes',{});
      return grants is map && grants.keys().hasOnly(['1','2','3']) && grants.keys().hasAll(old.keys()) &&
        retakeGrantValid(uid,'1',grants,old) && retakeGrantValid(uid,'2',grants,old) && retakeGrantValid(uid,'3',grants,old);
    }
    function dynamicBankReadable(uid,stage,version) {
      return exists(attemptDoc(uid,stage)) && get(attemptDoc(uid,stage)).data.status=='in_progress' &&
        get(attemptDoc(uid,stage)).data.get('bankSchema',1) in [2,3] && get(attemptDoc(uid,stage)).data.version==version &&
        sessionOpen(uid,stage) && stageDue(uid,stage);
    }

    function ordinaryProgramUpdate(uid,d,a) {
      return d.keys().hasOnly(['uid','email','startAt','active','createdAt','createdBy','resultAccessVersion','timeLimits','mode','enabledStages','updatedAt','updatedBy','retakes','stageProgress']) &&
        d.uid==a.uid && d.email==a.email && d.startAt==a.startAt &&
        d.createdAt==a.createdAt && d.createdBy==a.createdBy && d.active is bool &&
        d.resultAccessVersion==2 && progressOf(d)==progressOf(a) && limitsValid(d.timeLimits) && retakesValid(uid,d,a.get('retakes',{})) &&
        limitUnchanged(uid,'1',d.timeLimits) && limitUnchanged(uid,'2',d.timeLimits) && limitUnchanged(uid,'3',d.timeLimits) &&
        manualStageFlags(uid,d,a.get('enabledStages',{})) && releaseUnchanged(uid,'1',d) && releaseUnchanged(uid,'2',d) && releaseUnchanged(uid,'3',d) &&
        (d.get('mode','legacy')!='stages' || d.diff(a).affectedKeys().hasOnly(['active']) || (d.updatedAt==request.time && d.updatedBy==request.auth.uid));
    }
    match /expalsa_calidad_programas/{uid} {
      allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
      allow list: if expalsaAdmin();
      allow create: if expalsaAdmin() && activeTarget(uid) && request.resource.data.keys().hasOnly(['uid','email','startAt','active','createdAt','createdBy','resultAccessVersion','timeLimits','mode','enabledStages','updatedAt','updatedBy','retakes','stageProgress']) &&
        request.resource.data.uid==uid && request.resource.data.email==get(accessDoc(uid)).data.email && request.resource.data.startAt is timestamp &&
        request.resource.data.active==true && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.token.email &&
        request.resource.data.resultAccessVersion==2 && progressValid(uid,request.resource.data,{}) && limitsValid(request.resource.data.timeLimits) && retakesValid(uid,request.resource.data,{}) && manualStageFlags(uid,request.resource.data,{}) &&
        (request.resource.data.get('mode','legacy')!='stages' || (identityPresent(uid) && request.resource.data.updatedAt==request.time && request.resource.data.updatedBy==request.auth.uid));
      allow update: if expalsaAdmin() && (programCanClose(uid,request.resource.data,resource.data) || ordinaryProgramUpdate(uid,request.resource.data,resource.data));
      allow delete: if false;
    }
    match /expalsa_calidad_cuestionarios/{stage} {
      allow get: if expalsaAdmin() || (inspector() && stageDue(request.auth.uid,stage) && sessionOpen(request.auth.uid,stage) && get(attemptDoc(request.auth.uid,stage)).data.status=='in_progress' && get(attemptDoc(request.auth.uid,stage)).data.get('bankSchema',1)==1);
      allow list: if expalsaAdmin();
      allow create: if expalsaAdmin() && publishedBankValid(stage,request.resource.data);
      allow update,delete: if false;
    }
    function workshopPath(id) {return /databases/$(database)/documents/expalsa_calidad_talleres/$(id);}
    function workshopAnswer(id) {return /databases/$(database)/documents/expalsa_calidad_taller_respuestas/$(id);}
    function workshopTarget(t) {return t in ['K1','K2','K3','K4','K5','I1','I2','I3','I4','I5','I6','I7','I8','I9','I10','I11','I12'];}
    match /expalsa_calidad_taller_banco/{target} {
