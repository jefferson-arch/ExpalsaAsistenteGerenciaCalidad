           (resource.data.status=='active' && request.resource.data.status=='closed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            getAfter(attemptDoc(uid,stage)).data.status=='submitted' && resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data)));
        allow delete: if false;
      }
    }
    match /expalsa_calidad_resultados/{uid} {
      allow read,write: if false;
      match /etapas/{stage} {
        allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
        allow list: if expalsaAdmin();
        allow create,update: if (expalsaAdmin() || (inspector() && request.auth.uid==uid && request.resource.data.status in ['in_progress','submitted'])) &&
          validStage(stage,request.resource.data.stage) && resultMatches(uid,stage,request.resource.data);
        allow delete: if false;
      }
    }
    match /expalsa_calidad_etapas/{uid} {
      allow read,write: if false;
      match /entregas/{stage} {
        allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid && resource.data.status=='in_progress' && sessionOpen(uid,stage));
        allow list: if expalsaAdmin();
        
        allow create: if inspector() && request.auth.uid==uid && photoPresent(uid) && identityPresent(uid) &&
          validStage(stage,request.resource.data.stage) && stageDue(uid,stage) &&
          request.resource.data.keys().hasOnly(['uid','email','stage','startedAt','durationMinutes','status','version','answers','bankSchema']) && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email &&
          request.resource.data.status=='in_progress' && request.resource.data.startedAt==request.time && initialBankValid(request.resource.data,stage) &&
          getAfter(sessionDoc(uid,stage)).data.status=='active' && getAfter(sessionDoc(uid,stage)).data.startedAt==request.time && request.resource.data.durationMinutes==getAfter(sessionDoc(uid,stage)).data.durationMinutes &&
          resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data);
        allow update: if expalsaAdmin() ? (expiredDelivery(uid,stage) || gradedDelivery(uid,stage)) :
          (inspector() && request.auth.uid==uid && resource.data.status=='in_progress' &&
          ((sessionOpen(uid,stage) && request.resource.data.status=='in_progress' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','version']) &&
            attemptAnswersValid(stage,-1)) ||
           (sessionOpen(uid,stage) && finalDelivery(uid,stage) && request.resource.data.submissionKind=='manual' && attemptAnswersValid(stage,0)) ||
           expiredDelivery(uid,stage)));
        allow delete: if false;
      }
    }
function emAdmin() {
  return expalsaAdmin();
}
function emJefe(uid) {
  return exists(/databases/$(database)/documents/empaque_ejercicio_jefes/$(uid))
    && get(/databases/$(database)/documents/empaque_ejercicio_jefes/$(uid)).data.activo == true;
}
function emUsuario() {
  return accountEmail() &&
    request.auth.token.email.matches('^[^@]+@expalsaevaluations[.]com$') &&
    (emAdmin() || inspector() || emJefe(request.auth.uid));
}
function emLeeReporte(r) {
  return emUsuario() && (r.owner == request.auth.uid || emAdmin() || emJefe(request.auth.uid));
}
function emEditaReporte(r) {
  return emUsuario() && (r.owner == request.auth.uid || emAdmin());
}
match /empaque_ejercicio_jefes/{uid} {
  allow get: if emUsuario();
  allow list: if emAdmin();
  allow create, update: if emAdmin()
    && request.resource.data.keys().hasOnly(['nombre', 'activo'])
    && request.resource.data.nombre is string
    && request.resource.data.activo is bool;
  allow delete: if false;
}
match /empaque_ejercicio_qr/{token} {
  allow get: if emUsuario();
  allow list: if false;
  allow create: if emUsuario()
    && (emAdmin() || request.resource.data.uid == request.auth.uid)
    && emJefe(request.resource.data.uid)
    && token.matches('[a-f0-9]{64}')
    && request.resource.data.keys().hasOnly(['uid', 'activo', 'vence', 'creado'])
    && request.resource.data.activo == true
    && request.resource.data.creado == request.time
    && request.resource.data.vence > request.time
    && request.resource.data.vence <= request.time + duration.value(9, 'h');
  allow update, delete: if false;
}
match /empaque_ejercicio_ordenes/{id} {
  allow read: if emUsuario();
  allow create, update: if emAdmin();
}
match /empaque_ejercicio_materias/{id} {
  allow read: if emUsuario();
  allow create, update: if emAdmin();
}
match /empaque_ejercicio_residuales/{id} {
  allow read: if emUsuario();
  allow create, update: if emAdmin();
}
match /empaque_ejercicio_config/contador {
  allow read: if emUsuario();
  allow create: if emUsuario() && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == 1;
  allow update: if emUsuario() && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == resource.data.ultimo + 1;
}
match /empaque_ejercicio_reportes/{reporteId} {
  function baseActualizacion() {
    return emEditaReporte(resource.data)
      && resource.data.estado == 'abierto'
      && resource.data.eliminado == false
      && request.resource.data.owner == resource.data.owner
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.actualizado == request.time;
  }
  function edicion() {
    return request.resource.data.ultima.tipo == 'editar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muestras','alertas','pendientes','revision','actualizado','ultima'])
      && request.resource.data.muestras is list
      && request.resource.data.muestras.size() <= 12
      && request.resource.data.alertas is map
      && request.resource.data.pendientes is list
      && request.resource.data.pendientes.toSet().hasAll(resource.data.pendientes.toSet())
      && request.resource.data.alertas.diff(resource.data.alertas).changedKeys().size() == 0
      && request.resource.data.alertas.diff(resource.data.alertas).removedKeys().size() == 0
      && request.resource.data.alertas.diff(resource.data.alertas).addedKeys() == request.resource.data.pendientes.toSet().difference(resource.data.pendientes.toSet());
  }
  function autoriza() {
    let id = request.resource.data.ultima.alertaId;
    let hash = request.resource.data.ultima.tokenHash;
    let token = get(/databases/$(database)/documents/empaque_ejercicio_qr/$(hash)).data;
    let jefe = get(/databases/$(database)/documents/empaque_ejercicio_jefes/$(token.uid)).data;
    let aprobacion = request.resource.data.alertas[id].autorizacion;
    return request.resource.data.ultima.tipo == 'autorizar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alertas','pendientes','revision','actualizado','ultima'])
      && id in resource.data.pendientes
      && token.activo == true && token.vence > request.time && jefe.activo == true
      && request.resource.data.pendientes == resource.data.pendientes.removeAll([id])
      && request.resource.data.alertas.diff(resource.data.alertas).affectedKeys().hasOnly([id])
      && request.resource.data.alertas[id].diff(resource.data.alertas[id]).affectedKeys().hasOnly(['autorizacion'])
      && aprobacion.keys().hasOnly(['nombre','uid','tokenHash','fecha','registradoPor'])
      && aprobacion.nombre == jefe.nombre
      && aprobacion.uid == token.uid
      && aprobacion.tokenHash == hash
      && aprobacion.registradoPor == request.auth.uid;
  }
  function cierra() {
    return request.resource.data.ultima.tipo == 'cerrar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','cerrado','revision','actualizado','ultima'])
      && request.resource.data.estado == 'cerrado'
      && request.resource.data.cerrado == request.time
      && resource.data.pendientes.size() == 0
      && resource.data.muestras.size() > 0;
  }
  function elimina() {
    return request.resource.data.ultima.tipo == 'eliminar'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eliminado','revision','actualizado','ultima'])
      && request.resource.data.eliminado == true;
  }
  allow read: if emLeeReporte(resource.data);
  allow create: if emUsuario()
    && request.resource.data.owner == request.auth.uid
    && request.resource.data.estado == 'abierto'
    && request.resource.data.muestras == []
    && request.resource.data.alertas == {}
    && request.resource.data.pendientes == []
    && request.resource.data.revision == 0
    && request.resource.data.eliminado == false
    && request.resource.data.creado == request.time;
  allow update: if baseActualizacion() && (
    (request.resource.data.ultima.tipo == 'editar' && edicion())
    || (request.resource.data.ultima.tipo == 'autorizar' && autoriza())
    || (request.resource.data.ultima.tipo == 'cerrar' && cierra())
    || (request.resource.data.ultima.tipo == 'eliminar' && elimina())
  );
  allow delete: if false;
  match /fotos/{fotoId} {
    allow read: if emLeeReporte(get(/databases/$(database)/documents/empaque_ejercicio_reportes/$(reporteId)).data);
    allow create: if emEditaReporte(get(/databases/$(database)/documents/empaque_ejercicio_reportes/$(reporteId)).data)
      && get(/databases/$(database)/documents/empaque_ejercicio_reportes/$(reporteId)).data.estado == 'abierto'
      && request.resource.data.owner == request.auth.uid
      && request.resource.data.creado == request.time
      && request.resource.data.imagen is string
      && request.resource.data.imagen.size() <= 300000
      && request.resource.data.imagen.matches('data:image/jpeg;base64,.*');
    allow update, delete: if false;
  }
}

  }
}

