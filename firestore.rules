      allow create,update: if expalsaAdmin() && workshopTarget(target) && request.resource.data.keys().hasOnly(['questions','keys','explanations','updatedAt']) && request.resource.data.questions is list && request.resource.data.questions.size()==10 && request.resource.data.keys is list && request.resource.data.keys.size()==10 && request.resource.data.keys.hasOnly([0,1,2,3]) && request.resource.data.explanations is list && request.resource.data.explanations.size()==10;
      allow delete: if false;
    }
    match /expalsa_calidad_talleres/{id} {
      allow list: if expalsaAdmin();
      allow get: if expalsaAdmin() || (inspector() && resource.data.uid==request.auth.uid && resource.data.stage==activeStage(request.auth.uid) && !exists(workshopAnswer(id)) && exists(/databases/$(database)/documents/expalsa_calidad_taller_borradores/$(id)));
      allow create: if expalsaAdmin() && request.resource.data.keys().hasOnly(['uid','stage','target','trainingId','title','questions','assignedAt','assignedBy']) && activeTarget(request.resource.data.uid) && request.resource.data.stage==activeStage(request.resource.data.uid) && request.resource.data.stage in [1,2,3] && workshopTarget(request.resource.data.target) && id=='T-'+request.resource.data.trainingId && request.resource.data.assignedAt==request.time && request.resource.data.assignedBy==request.auth.uid && get(dailyDoc(request.resource.data.trainingId)).data.uid==request.resource.data.uid && get(dailyDoc(request.resource.data.trainingId)).data.v2.kind=='course' && get(dailyDoc(request.resource.data.trainingId)).data.evaluationStage==request.resource.data.stage && get(dailyDoc(request.resource.data.trainingId)).data.v2.target==request.resource.data.target && request.resource.data.questions==get(/databases/$(database)/documents/expalsa_calidad_taller_banco/$(request.resource.data.target)).data.questions && getAfter(/databases/$(database)/documents/expalsa_calidad_taller_claves/$(id)).data.keys==get(/databases/$(database)/documents/expalsa_calidad_taller_banco/$(request.resource.data.target)).data.keys;
      allow update,delete: if false;
    }
    match /expalsa_calidad_taller_claves/{id} {
