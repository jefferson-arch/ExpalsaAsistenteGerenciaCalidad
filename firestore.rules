// ===============================================================
// Assumed data model added for mapa-calidad.html
//
// grados/{gradeId}: l/r/q/t/s/m/c strings and lo/hi percentages.
// destinos/{destinationId}: tipo, nombre, grados and optional country,
// continent, latitude and longitude fields. Each record is admin managed.
// clientes_calidad/{clientId}: nombre/tipo and bounded optional geography.
// A ficha técnica references an existing client document and optional city.
// fichas_tecnicas_calidad/{id}: extracted product criteria/text and PDF metadata.
// expalsa_calidad_dispositivos/{uid}/equipos/{deviceId}: server-managed
// device identity, public key and active/pending/revoked status.
// Access for this page requires the configured administrator identity, or an
// active expalsa_calidad_accesos/{uid} record and a matching active device ID
// in the Firebase Auth token. Fabio and Karina are trusted Calidad admins;
// they still require an active evaluations access record but do not require
// device approval. Device keys and status are server-managed by trusted functions.
// ===============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function expalsaAdmin() {
      return request.auth!=null && request.auth.token.email=='jefferson@expalsaevaluations.com' && administratorMatches();
    }
    function administratorMatches() {
      let admin=get(/databases/$(database)/documents/expalsa_calidad_config/administrador).data;
      return admin.uid==request.auth.uid && admin.email==request.auth.token.email;
    }
    function accountEmail() { return signedIn() && request.auth.token.email is string && request.auth.token.email.matches('^[^@]+@[^@]+$'); }
    function accessDoc(uid) { return /databases/$(database)/documents/expalsa_calidad_accesos/$(uid); }
    function inspector() {
      return accountEmail() && !expalsaAdmin() && exists(accessDoc(request.auth.uid)) &&
        get(accessDoc(request.auth.uid)).data.active == true &&
        get(accessDoc(request.auth.uid)).data.get('deleted', false) != true &&
        get(accessDoc(request.auth.uid)).data.email == request.auth.token.email;
    }
    function calidadDevicePath(uid) {
      return /databases/$(database)/documents/expalsa_calidad_dispositivos/$(uid)/equipos/$(request.auth.token.calidadDeviceId);
    }
    function calidadPageAdmin() {
      return expalsaAdmin() || calidadTrustedAdmin();
    }
    function calidadTrustedAdmin() {
      return signedIn() && request.auth.token.email is string &&
        request.auth.token.email in ['fabio@expalsaevaluations.com','karina@expalsaevaluations.com'] &&
        inspector();
    }
    function calidadPageUser() {
      return expalsaAdmin() || calidadTrustedAdmin() ||
        (signedIn() && request.auth.token.calidadDeviceId is string &&
         exists(calidadDevicePath(request.auth.uid)) &&
         get(calidadDevicePath(request.auth.uid)).data.status == 'active' &&
         inspector());
    }
    function validCalidadGrade(d) {
      return d.keys().hasOnly(['l','r','lo','hi','q','t','s','m','c']) &&
        d.keys().hasAll(['l','r','lo','hi','q','t','s','m','c']) &&
        d.l is string && d.l.size() <= 20 && d.r is string && d.r.size() <= 40 &&
        d.lo is number && d.lo >= 0 && d.lo <= 100 && d.hi is number && d.hi >= d.lo && d.hi <= 100 &&
        d.q is string && d.q.size() <= 50 && d.t in ['ok','no','mid','flex'] &&
        d.s is string && d.s.size() <= 120 && d.m is string && d.m.size() <= 120 &&
        d.c is string && d.c.matches('^#[0-9A-Fa-f]{6}$');
    }
    function validCalidadDestination(d) {
      return d.keys().hasOnly(['tipo','codigo','nombre','continente','pais','lat','lon','grados']) &&
        d.keys().hasAll(['tipo','nombre','grados']) && d.tipo in ['pais','continente','ciudad'] &&
        d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 100 &&
        d.grados is list && d.grados.size() <= 10 &&
        (!('codigo' in d) || (d.codigo is string && d.codigo.size() <= 20)) &&
        (!('continente' in d) || (d.continente is string && d.continente.size() <= 30)) &&
        (!('pais' in d) || (d.pais is string && d.pais.size() <= 3)) &&
        (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90)) &&
        (!('lon' in d) || (d.lon is number && d.lon >= -180 && d.lon <= 180));
    }
    function calidadDestinationPath(id) {
      return /databases/$(database)/documents/destinos/$(id);
    }
    function calidadClientCityMatches(d) {
      return !('ciudadId' in d) || (
        existsAfter(calidadDestinationPath(d.ciudadId)) &&
        getAfter(calidadDestinationPath(d.ciudadId)).data.tipo == 'ciudad' &&
        getAfter(calidadDestinationPath(d.ciudadId)).data.pais == d.pais &&
        getAfter(calidadDestinationPath(d.ciudadId)).data.nombre == d.ciudad);
    }
    function validCalidadClientLocation(d) {
      return (('ciudadId' in d) == ('ciudad' in d)) &&
        (('ciudadId' in d) ?
          (d.ciudadId is string && d.ciudadId.size() > 0 && d.ciudadId.size() <= 180 &&
           d.ciudad is string && d.ciudad.size() > 0 && d.ciudad.size() <= 100 &&
           d.pais is string && d.pais.matches('^[A-Z]{2}$')) :
          (('pais' in d) || ('continente' in d)));
    }
    function validCalidadClientGradeOverride(o) {
      return o is map && o.keys().hasOnly(['hi','lo','r','q','m']) &&
        o.keys().hasAll(['hi','lo','r','q','m']) &&
        o.lo is number && o.lo >= 0 && o.lo <= 100 &&
        o.hi is number && o.hi >= o.lo && o.hi <= 100 &&
        o.r is string && o.r.size() <= 40 &&
        o.q is string && o.q.size() <= 50 &&
        o.m is string && o.m.size() <= 120;
    }
    function validCalidadClientGrade(item) {
      return item is map && item.keys().hasOnly(['g','o']) &&
        item.keys().hasAll(['g']) &&
        item.g in ['AAA','AA','A40','A50','A60','Am','Alt'] &&
        (!('o' in item) || validCalidadClientGradeOverride(item.o));
    }
    function validCalidadClientGrades(grades) {
      return grades is list && grades.size() <= 10 &&
        (grades.size() < 1 || validCalidadClientGrade(grades[0])) &&
        (grades.size() < 2 || validCalidadClientGrade(grades[1])) &&
        (grades.size() < 3 || validCalidadClientGrade(grades[2])) &&
        (grades.size() < 4 || validCalidadClientGrade(grades[3])) &&
        (grades.size() < 5 || validCalidadClientGrade(grades[4])) &&
        (grades.size() < 6 || validCalidadClientGrade(grades[5])) &&
        (grades.size() < 7 || validCalidadClientGrade(grades[6])) &&
        (grades.size() < 8 || validCalidadClientGrade(grades[7])) &&
        (grades.size() < 9 || validCalidadClientGrade(grades[8])) &&
        (grades.size() < 10 || validCalidadClientGrade(grades[9]));
    }
    function validCalidadClient(d) {
      return d.keys().hasOnly(['ciudadId','pais','ciudad','nombre','tipo','puerto','continente','grados']) &&
        d.keys().hasAll(['nombre','tipo']) && validCalidadClientLocation(d) &&
        d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120 &&
        d.tipo in ['cliente','importador'] &&
        (!('pais' in d) || (d.pais is string && d.pais.matches('^[A-Z]{2}$'))) &&
        (!('continente' in d) || (d.continente is string && d.continente.size() > 0 && d.continente.size() <= 30)) &&
        (!('puerto' in d) || (d.puerto is string && d.puerto.size() <= 120)) &&
        (!('grados' in d) || validCalidadClientGrades(d.grados)) && calidadClientCityMatches(d);
    }
    function validFichaCalibre(c) {
      return c is map && c.keys().hasOnly(['talla','piezasKg','uniformidad']) &&
        c.keys().hasAll(['talla','piezasKg','uniformidad']) &&
        c.talla is string && c.talla.size() <= 40 &&
        c.piezasKg is string && c.piezasKg.size() <= 40 &&
        c.uniformidad is string && c.uniformidad.size() <= 40;
    }
    function validFichaCalibres(a) {
      return a is list && a.size() <= 30 &&
        (a.size() < 1 || validFichaCalibre(a[0])) &&
        (a.size() < 2 || validFichaCalibre(a[1])) &&
        (a.size() < 3 || validFichaCalibre(a[2])) &&
        (a.size() < 4 || validFichaCalibre(a[3])) &&
        (a.size() < 5 || validFichaCalibre(a[4])) &&
        (a.size() < 6 || validFichaCalibre(a[5])) &&
        (a.size() < 7 || validFichaCalibre(a[6])) &&
        (a.size() < 8 || validFichaCalibre(a[7])) &&
        (a.size() < 9 || validFichaCalibre(a[8])) &&
        (a.size() < 10 || validFichaCalibre(a[9])) &&
        (a.size() < 11 || validFichaCalibre(a[10])) &&
        (a.size() < 12 || validFichaCalibre(a[11])) &&
        (a.size() < 13 || validFichaCalibre(a[12])) &&
        (a.size() < 14 || validFichaCalibre(a[13])) &&
        (a.size() < 15 || validFichaCalibre(a[14])) &&
        (a.size() < 16 || validFichaCalibre(a[15])) &&
        (a.size() < 17 || validFichaCalibre(a[16])) &&
        (a.size() < 18 || validFichaCalibre(a[17])) &&
        (a.size() < 19 || validFichaCalibre(a[18])) &&
        (a.size() < 20 || validFichaCalibre(a[19])) &&
        (a.size() < 21 || validFichaCalibre(a[20])) &&
        (a.size() < 22 || validFichaCalibre(a[21])) &&
        (a.size() < 23 || validFichaCalibre(a[22])) &&
        (a.size() < 24 || validFichaCalibre(a[23])) &&
        (a.size() < 25 || validFichaCalibre(a[24])) &&
        (a.size() < 26 || validFichaCalibre(a[25])) &&
        (a.size() < 27 || validFichaCalibre(a[26])) &&
        (a.size() < 28 || validFichaCalibre(a[27])) &&
        (a.size() < 29 || validFichaCalibre(a[28])) &&
        (a.size() < 30 || validFichaCalibre(a[29]));
    }
    function validFichaTecnica(d, id) {
      return id is string && id.size() > 0 && id.size() <= 180 &&
        d.keys().hasOnly(['clienteId','clienteNombre','tipoCliente','producto','codigoProducto','categoria','criterios','materiaExtrana','sabor','pais','continente','ciudadId','ciudad','puerto','textoExtraido','pdfNombre','metadata','estado','calibres']) &&
        d.keys().hasAll(['clienteId','clienteNombre','tipoCliente','producto','criterios','textoExtraido','pdfNombre','metadata']) &&
        d.clienteId is string && d.clienteId.size() > 0 && d.clienteId.size() <= 180 &&
        d.clienteNombre is string && d.clienteNombre.size() > 0 && d.clienteNombre.size() <= 120 &&
        d.tipoCliente in ['cliente','importador'] &&
        d.producto is string && d.producto.size() > 0 && d.producto.size() <= 200 &&
        (!('estado' in d) || d.estado in ['activa','inactiva']) &&
        (!('calibres' in d) || validFichaCalibres(d.calibres)) &&
        (!('codigoProducto' in d) || (d.codigoProducto is string && d.codigoProducto.size() <= 120)) &&
        (!('categoria' in d) || (d.categoria is string && d.categoria.size() <= 120)) &&
        d.criterios is list && d.criterios.size() <= 25 &&
        (!('materiaExtrana' in d) || (d.materiaExtrana is string && d.materiaExtrana.size() <= 1000)) &&
        (!('sabor' in d) || (d.sabor is string && d.sabor.size() <= 1000)) &&
        d.textoExtraido is string && d.textoExtraido.size() <= 50000 &&
        d.pdfNombre is string && d.pdfNombre.size() > 0 && d.pdfNombre.size() <= 200 &&
        d.metadata is map && d.metadata.size() <= 4 &&
        (!('pais' in d) || (d.pais is string && d.pais.matches('^[A-Z]{2}$'))) &&
        (!('continente' in d) || (d.continente is string && d.continente.size() > 0 && d.continente.size() <= 30)) &&
        (!('ciudadId' in d) || (d.ciudadId is string && d.ciudadId.size() > 0 && d.ciudadId.size() <= 180)) &&
        (!('ciudad' in d) || (d.ciudad is string && d.ciudad.size() > 0 && d.ciudad.size() <= 100)) &&
        (!('puerto' in d) || (d.puerto is string && d.puerto.size() <= 120));
    }
    function photoDoc(uid) { return /databases/$(database)/documents/expalsa_calidad_fotos_perfil/$(uid); }
    function photoPresent(uid) {
      let photo=get(photoDoc(uid)).data;
      return photo.uid==uid && photo.path=='expalsa_calidad_fotos/'+uid+'/perfil.jpg' && photo.origin in ['camera','gallery'];
    }
    function programDoc(uid) { return /databases/$(database)/documents/expalsa_calidad_programas/$(uid); }
    function attemptDoc(uid,stage) { return /databases/$(database)/documents/expalsa_calidad_etapas/$(uid)/entregas/$(stage); }
    function resultDoc(uid,stage) { return /databases/$(database)/documents/expalsa_calidad_resultados/$(uid)/etapas/$(stage); }
    function sessionDoc(uid,stage) { return /databases/$(database)/documents/expalsa_calidad_sesiones/$(uid)/etapas/$(stage); }
    function stageBank(stage) { return /databases/$(database)/documents/expalsa_calidad_cuestionarios/$(stage); }
    function stageKey(stage) { return /databases/$(database)/documents/expalsa_calidad_claves/$(stage); }
    function dynamicBank(version) { return /databases/$(database)/documents/expalsa_calidad_bancos/$(version); }
    function dynamicKey(version) { return /databases/$(database)/documents/expalsa_calidad_soluciones/$(version); }
    function stageName(n) { return n==1?'1':n==2?'2':'3'; }
    function evaluationConfig() { return /databases/$(database)/documents/expalsa_calidad_config/evaluaciones; }
    function retryStage(stage) { return stage in ['1_2','2_2','3_2']; }
    function baseStage(stage) { return stage in ['1','1_2']?'1':stage in ['2','2_2']?'2':'3'; }
    function validStage(stage,n) { return (stage in ['1','1_2'] && n==1) || (stage in ['2','2_2'] && n==2) || (stage in ['3','3_2'] && n==3); }
    function limitValid(n) { return n is int && n>=1 && n<=180; }
    function limitsValid(t) { return t is map && t.keys().hasOnly(['1','2','3']) && t.keys().hasAll(['1','2','3']) && limitValid(t['1']) && limitValid(t['2']) && limitValid(t['3']); }
    function limitUnchanged(uid,stage,t) { return t[stage]==resource.data.get('timeLimits',{}).get(stage,-1) || !exists(sessionDoc(uid,stage)) || t[stage]==get(sessionDoc(uid,stage)).data.durationMinutes; }
    function theoryDone(uid,stage) {
      return exists(attemptDoc(uid,stage)) && get(attemptDoc(uid,stage)).data.status in ['submitted','graded'] &&
        (get(attemptDoc(uid,stage)).data.status=='graded' || exists(automaticResultDoc(uid,stage)));
    }
    function priorGraded(uid,stage) {
      return retryStage(stage) ? true : stage=='1' || (stage=='2' && theoryDone(uid,'1')) || (stage=='3' && theoryDone(uid,'2'));
    }
    function stageNumber(stage) { return stage in ['1','1_2']?1:stage in ['2','2_2']?2:3; }
    function progressKey(n) { return n==1?'1':n==2?'2':'3'; }
    function progressOf(p) { return p.get('stageProgress',{'version':1,'active':1,'closed':{}}); }
    function activeStage(uid) { return exists(programDoc(uid))?progressOf(get(programDoc(uid)).data).active:1; }
    function evaluationStage(d) { return d.get('evaluationStage',1); }
    function dailyStageOpen(d) { return evaluationStage(d) in [1,2,3] && evaluationStage(d)==activeStage(d.uid); }
    function previousClosed(p,n) { return n==1 || progressOf(p).closed.keys().hasAny([n==2?'1':'2']); }
    function progressValid(uid,d,old) {
      let a=progressOf(old);
      let b=progressOf(d);
      let key=progressKey(a.active);
      return b==a || (a.active in [1,2,3] && d.active==true && activeTarget(uid) &&
        b is map && b.keys().hasOnly(['version','active','closed']) && b.version==1 && b.active==a.active+1 &&
        b.closed is map && b.closed.keys().hasOnly(['1','2','3']) && b.closed.size()==a.closed.size()+1 &&
        b.closed.diff(a.closed).affectedKeys().hasOnly([key]) && b.closed.keys().hasAll(a.closed.keys()) &&
        closeEntryValid(uid,key,a.active,b.closed[key],d));
    }
    function closeEntryValid(uid,key,n,c,p) {
      let practice=get(dailyDoc(c.practiceId)).data;
      return c is map && c.keys().hasOnly(['at','by','practiceId']) && c.at==request.time && c.by==request.auth.uid &&
        theoryDone(uid,key) && (!p.get('retakes',{}).get(key,{}).get('enabled',false) || theoryDone(uid,key+'_2')) &&
        practice.uid==uid && evaluationStage(practice)==n && practice.get('voided',false)==false &&
        (practice.get('v2',{}).get('kind','')=='practical'?(practice.v2.values.keys().hasAll(['P1_1', 'P2_1', 'P3_1', 'P3_2', 'P4_1', 'P5_1', 'P5_2', 'P5_3', 'P10_1', 'P11_1', 'P11_2', 'P11_3', 'P11_4', 'P11_5', 'P11_6', 'P11_7', 'P11_8', 'P12_1', 'P13_1', 'P13_2', 'P13_3', 'P13_4', 'P13_5', 'P13_6', 'P13_7', 'P13_8', 'P13_9']) && practice.v2.values.keys().hasAny(['P6_1', 'P6_2', 'P6_3', 'P6_4', 'P6_5', 'P6_6', 'P6_7', 'P6_8']) && practice.v2.values.keys().hasAny(['P7_1', 'P7_2', 'P7_3', 'P7_4', 'P7_5', 'P7_6', 'P7_7', 'P7_8']) && practice.v2.values.keys().hasAny(['P8_1', 'P8_2', 'P8_3', 'P8_4', 'P8_5', 'P8_6', 'P8_7', 'P8_8']) && practice.v2.values.keys().hasAny(['P9_1', 'P9_2', 'P9_3', 'P9_4', 'P9_5', 'P9_6', 'P9_7', 'P9_8'])):practice.ratings.values().hasAny([0,1,2,3,4])) && practice.createdAt<=request.time;
    }
    function rawRecordStage(d) {
      let profile=getAfter(/databases/$(database)/documents/expalsa_calidad_perfiles/$(d.payload.profileId)).data.payload;
      return evaluationStage(d.payload) in [1,2,3] && evaluationStage(d.payload)==activeStage(profile.accountUid);
    }
    function trainingStageValid(d,old) {
      let added=d.get('training',[]).removeAll(old.get('training',[]));
      let removed=old.get('training',[]).removeAll(d.get('training',[]));
      let stage=activeStage(d.accountUid);
      return added.size()<=1 && removed.size()<=1 &&
        (added.size()==0 || (stage in [1,2,3] && evaluationStage(added[0])==stage)) &&
        (removed.size()==0 || (stage in [1,2,3] && evaluationStage(removed[0])==stage));
    }
    function programCanClose(uid,d,a) {
      return d.diff(a).affectedKeys().hasOnly(['stageProgress','enabledStages','mode','updatedAt','updatedBy']) &&
        progressOf(d).active==progressOf(a).active+1 && d.mode=='stages' && d.updatedAt==request.time && d.updatedBy==request.auth.uid &&
        progressValid(uid,d,a) && manualStageFlags(uid,d,a.get('enabledStages',{}));
    }
    function stageDue(uid,stage) {
      let p=get(programDoc(uid)).data;
      return p.active==true && p.resultAccessVersion==2 && progressOf(p).active==stageNumber(stage) &&
        (retryStage(stage) ? p.get('retakes',{}).get(baseStage(stage),{}).get('enabled',false)==true :
        ((p.get('mode','legacy')=='stages' && p.get('enabledStages',{}).get(stage,false)==true) ||
         (exists(sessionDoc(uid,stage)) && get(sessionDoc(uid,stage)).data.status=='active')));
    }
    function sessionOpen(uid,stage) {
      let s=get(sessionDoc(uid,stage)).data;
      return s.status=='active' && request.time<s.startedAt+duration.value(s.durationMinutes*60,'s');
    }
    function sessionExpired(uid,stage) {
      let s=get(sessionDoc(uid,stage)).data;
      return s.status=='active' && request.time>=s.startedAt+duration.value(s.durationMinutes*60,'s');
    }
    function timingMatches(d,a) {
      return (a.keys().hasAll(['startedAt','durationMinutes']) && d.keys().hasAll(['startedAt','durationMinutes']) && d.startedAt==a.startedAt && d.durationMinutes==a.durationMinutes) ||
        (!a.keys().hasAny(['startedAt','durationMinutes']) && !d.keys().hasAny(['startedAt','durationMinutes']));
    }
    function resultMatches(uid,stage,d) {
      let a=getAfter(attemptDoc(uid,stage)).data;
      return d.keys().hasOnly(['uid','email','stage','status','startedAt','durationMinutes','submittedAt','score','skillScore','integratedScore','gradedAt']) &&
        d.keys().hasAll(['uid','email','stage','status']) && d.uid==uid && d.uid==a.uid && d.email==a.email && validStage(stage,d.stage) && d.stage==a.stage && d.status==a.status && timingMatches(d,a) &&
        ((a.status=='in_progress' && d.keys().hasOnly(['uid','email','stage','status','startedAt','durationMinutes'])) ||
         (a.status=='submitted' && d.submittedAt==a.submittedAt && !d.keys().hasAny(['score','skillScore','integratedScore','gradedAt'])) ||
         (a.status=='graded' && d.submittedAt==a.submittedAt && d.score==a.score && d.skillScore==a.skillScore && d.integratedScore==a.integratedScore && d.gradedAt==a.gradedAt));
    }
    function answerValid(a,q,minimum) { let v=a.get(q.id,-1); return v is int && v>=minimum && v<=3; }
    function answersValid(a,b,minimum) {
      return a is map && a.keys().hasOnly([b.questions[0].id,b.questions[1].id,b.questions[2].id,b.questions[3].id,b.questions[4].id,b.questions[5].id,b.questions[6].id,b.questions[7].id,b.questions[8].id,b.questions[9].id,b.questions[10].id,b.questions[11].id]) &&
        answerValid(a,b.questions[0],minimum) && answerValid(a,b.questions[1],minimum) && answerValid(a,b.questions[2],minimum) && answerValid(a,b.questions[3],minimum) &&
        answerValid(a,b.questions[4],minimum) && answerValid(a,b.questions[5],minimum) && answerValid(a,b.questions[6],minimum) && answerValid(a,b.questions[7],minimum) &&
        answerValid(a,b.questions[8],minimum) && answerValid(a,b.questions[9],minimum) && answerValid(a,b.questions[10],minimum) && answerValid(a,b.questions[11],minimum);
    }
    function questionValid(q) {
      return q.keys().hasOnly(['id','topic','text','options']) && q.id is string && q.topic is string && q.text is string &&
        q.options is list && q.options.size()==4;
    }
    function publishedBankValid(stage,d) {
      return d.keys().hasOnly(['stage','version','title','questions','skills','updatedAt']) && validStage(stage,d.stage) &&
        d.version is string && d.version.size()>0 && d.title is string && d.updatedAt==request.time && d.skills is list && d.skills.size()==4 &&
        d.questions is list && d.questions.size()==12 &&
        questionValid(d.questions[0]) && questionValid(d.questions[1]) && questionValid(d.questions[2]) && questionValid(d.questions[3]) &&
        questionValid(d.questions[4]) && questionValid(d.questions[5]) && questionValid(d.questions[6]) && questionValid(d.questions[7]) &&
        questionValid(d.questions[8]) && questionValid(d.questions[9]) && questionValid(d.questions[10]) && questionValid(d.questions[11]) &&
        getAfter(stageKey(stage)).data.stage==d.stage && getAfter(stageKey(stage)).data.version==d.version;
    }
    function publishedKeyValid(stage,d) {
      let b=getAfter(stageBank(stage)).data;
      return d.keys().hasOnly(['stage','version','keys','updatedAt']) && validStage(stage,d.stage) && d.updatedAt==request.time &&
        d.stage==b.stage && d.version==b.version && d.keys is map && d.keys.size()==12 && answersValid(d.keys,b,0);
    }
    function dynamicBankValid(version,d) {
      return d.keys().hasOnly(['schema','stage','version','title','questionIds','writtenIds','questions','updatedAt']) &&
        d.schema in [2,3] && d.stage in [1,2,3] && d.version==version && d.title is string && d.updatedAt==request.time &&
        d.questions is list && (d.schema!=3 || d.questions.size() in [28,30,43,44]) && d.questionIds is list && d.questions.size()==d.questionIds.size() && d.questions.size()>=1 && d.questions.size()<=60 &&
        d.questionIds.toSet().size()==d.questionIds.size() && d.writtenIds is list && d.writtenIds.hasOnly(d.questionIds) &&
        getAfter(dynamicKey(version)).data.version==version && getAfter(dynamicKey(version)).data.stage==d.stage;
    }
    function dynamicKeyValid(version,d) {
      let b=getAfter(dynamicBank(version)).data;
      return d.keys().hasOnly(['schema','stage','version','keys','canonicalAnswers','updatedAt']) && d.schema in [2,3] && d.version==version &&
        d.stage==b.stage && d.updatedAt==request.time && d.keys is map && d.keys.keys().hasOnly(b.questionIds) && d.keys.keys().hasAll(b.questionIds) && (!(b.questionIds.size() in [43,44]) || (d.canonicalAnswers is map && d.canonicalAnswers.keys().hasOnly(b.questionIds) && d.canonicalAnswers.keys().hasAll(b.questionIds)));
    }
    function configurationValid(d) {
      return d.keys().hasOnly(['schema','versions','counts','durationMinutes','updatedAt']) && d.schema in [2,3] && d.updatedAt==request.time && d.durationMinutes in [15,30] &&
        d.versions.keys().hasOnly(['1','2','3']) && d.versions.keys().hasAll(['1','2','3']) && d.counts.keys().hasOnly(['1','2','3']) && d.counts.keys().hasAll(['1','2','3']) &&
        get(dynamicBank(d.versions['1'])).data.stage==1 && get(dynamicKey(d.versions['1'])).data.stage==1 && d.counts['1']==get(dynamicBank(d.versions['1'])).data.questions.size() &&
        get(dynamicBank(d.versions['2'])).data.stage==2 && get(dynamicKey(d.versions['2'])).data.stage==2 && d.counts['2']==get(dynamicBank(d.versions['2'])).data.questions.size() &&
        get(dynamicBank(d.versions['3'])).data.stage==3 && get(dynamicKey(d.versions['3'])).data.stage==3 && d.counts['3']==get(dynamicBank(d.versions['3'])).data.questions.size();
    }
    function bankAvailable(uid,stage) {
      let a=getAfter(attemptDoc(uid,stage)).data;
      return a.get('bankSchema',1) in [2,3] ? exists(dynamicBank(a.version)) : exists(stageBank(stage));
    }
    function automaticAnswersValid(a,version,minimum) {
      let ids=get(dynamicBank(version)).data.questionIds;
      return a is map && a.size()<=ids.size() && a.keys().hasOnly(ids) &&
        (minimum<0 || (a.keys().hasAll(ids) && !a.values().hasAny([''])));
    }
    function initialBankValid(d,stage) {
      return d.get('bankSchema',1) in [2,3] ?
        (d.version==(retryStage(stage)?get(programDoc(d.uid)).data.retakes[baseStage(stage)].version:assignedVersion(d.uid,stage,get(evaluationConfig()).data.versions[stage])) && get(dynamicBank(d.version)).data.stage==d.stage &&
         d.bankSchema==get(dynamicBank(d.version)).data.schema && (d.bankSchema==3 ? d.answers is map && d.answers.size()==0 : d.answers=='{}')) :
        (!d.keys().hasAny(['bankSchema']) && d.version=='' && d.answers is map && d.answers.size()==0);
    }
    function attemptAnswersValid(stage,minimum) {
      let d=request.resource.data;
      return resource.data.get('bankSchema',1)==3 ?
        (d.version==resource.data.version && automaticAnswersValid(d.answers,d.version,minimum)) :
        resource.data.get('bankSchema',1)==2 ?
        (d.version==resource.data.version && d.answers is string && d.answers.size()<=40000 && d.answers.size()>=(minimum==0?3:2)) :
        (d.version==get(stageBank(stage)).data.version && answersValid(d.answers,get(stageBank(stage)).data,minimum));
    }
    function writtenScoresValid(d) {
      let ids=get(dynamicBank(d.version)).data.writtenIds;
      return d.writtenScores is map && d.writtenScores.keys().hasOnly(ids) && d.writtenScores.keys().hasAll(ids) &&
        d.writtenScores.values().hasOnly([0,0.25,0.5,0.75,1]);
    }
    function identityStable() {
      return request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email && request.resource.data.stage==resource.data.stage &&
        request.resource.data.startedAt==resource.data.startedAt && request.resource.data.durationMinutes==resource.data.durationMinutes &&
        request.resource.data.get('bankSchema',1)==resource.data.get('bankSchema',1);
    }
    function finalDelivery(uid,stage) {
      return resource.data.status=='in_progress' && request.resource.data.status=='submitted' && identityStable() &&
        request.resource.data.keys().hasOnly(['uid','email','stage','startedAt','durationMinutes','version','answers','status','submittedAt','submissionKind','bankSchema']) &&
        request.resource.data.submittedAt==request.time && getAfter(sessionDoc(uid,stage)).data.status=='closed' && resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data);
    }
    function expiredDelivery(uid,stage) {
      return finalDelivery(uid,stage) && sessionExpired(uid,stage) && request.resource.data.submissionKind=='expired' &&
        request.resource.data.answers==resource.data.answers && request.resource.data.version==resource.data.version;
    }
    function skillValid(s,id) {
      let r=s.rating;
      let e=s.evidence;
      return s.id==id && r is int && r>=0 && r<=4 && e is string && e.size()>=20;
    }
    function gradedDelivery(uid,stage) {
      let d=request.resource.data;
      let a=resource.data;
      return activeStage(uid)==stageNumber(stage) && a.status=='submitted' && d.status=='graded' &&
        d.keys().hasOnly(['uid','email','stage','version','answers','status','submittedAt','startedAt','durationMinutes','submissionKind','bankSchema','writtenScores',
          'score','correctCount','total','skillScore','skills','integratedScore','observation','gradedAt','gradedBy']) &&
        d.diff(a).affectedKeys().hasOnly(['status','score','correctCount','total','skillScore','skills','integratedScore','observation','gradedAt','gradedBy','writtenScores']) &&
        d.score is number && d.score>=0 && d.score<=100 && d.correctCount is int && d.total is int &&
        d.skillScore is int && d.skillScore>=0 && d.skillScore<=100 && d.integratedScore is int && d.integratedScore>=0 && d.integratedScore<=100 &&
        d.skills is list && d.skills.size()==10 &&
        skillValid(d.skills[0],'C1') && skillValid(d.skills[1],'C2') && skillValid(d.skills[2],'C3') && skillValid(d.skills[3],'C4') && skillValid(d.skills[4],'C5') &&
        skillValid(d.skills[5],'C6') && skillValid(d.skills[6],'C7') && skillValid(d.skills[7],'C8') && skillValid(d.skills[8],'C9') && skillValid(d.skills[9],'C10') &&
        d.observation is string && d.observation.size()>=12 && d.gradedAt==request.time && d.gradedBy==request.auth.token.email &&
        (a.get('bankSchema',1)==2?writtenScoresValid(d):!d.keys().hasAny(['writtenScores'])) &&
        resultMatches(uid,stage,getAfter(resultDoc(uid,stage)).data);
    }

    function automaticResultDoc(uid,stage) { return /databases/$(database)/documents/expalsa_calidad_autocalificaciones/$(uid)/etapas/$(stage); }
    function automaticReader(uid) { return expalsaAdmin() || (inspector() && request.auth.uid==uid); }
    function closedForScoring(uid,stage) {
      let a=get(attemptDoc(uid,stage)).data;
      return a.status in ['submitted','graded'] && a.uid==uid && validStage(stage,a.stage) &&
        get(sessionDoc(uid,stage)).data.status=='closed' &&
        (a.get('bankSchema',1)==3 || a.get('bankSchema',1)==1);
    }
    function automaticTotal(uid,stage) {
      let a=get(attemptDoc(uid,stage)).data;
      return a.get('bankSchema',1)==3 ? get(dynamicBank(a.version)).data.questionIds.size() : get(stageBank(stage)).data.questions.size();
    }
    function automaticHit(a,k,id) { return a.get(id,'') in k[id].canonical ? 1 : 0; }
    function automaticThirty(a,b,k) {
      let ids=b.questionIds;
      return (a.get(ids[0],'') in k[ids[0]].canonical ? 1 : 0) + (a.get(ids[1],'') in k[ids[1]].canonical ? 1 : 0) + (a.get(ids[2],'') in k[ids[2]].canonical ? 1 : 0) + (a.get(ids[3],'') in k[ids[3]].canonical ? 1 : 0) + (a.get(ids[4],'') in k[ids[4]].canonical ? 1 : 0) + (a.get(ids[5],'') in k[ids[5]].canonical ? 1 : 0) + (a.get(ids[6],'') in k[ids[6]].canonical ? 1 : 0) + (a.get(ids[7],'') in k[ids[7]].canonical ? 1 : 0) + (a.get(ids[8],'') in k[ids[8]].canonical ? 1 : 0) + (a.get(ids[9],'') in k[ids[9]].canonical ? 1 : 0) + (a.get(ids[10],'') in k[ids[10]].canonical ? 1 : 0) + (a.get(ids[11],'') in k[ids[11]].canonical ? 1 : 0) + (a.get(ids[12],'') in k[ids[12]].canonical ? 1 : 0) + (a.get(ids[13],'') in k[ids[13]].canonical ? 1 : 0) + (a.get(ids[14],'') in k[ids[14]].canonical ? 1 : 0) + (a.get(ids[15],'') in k[ids[15]].canonical ? 1 : 0) + (a.get(ids[16],'') in k[ids[16]].canonical ? 1 : 0) + (a.get(ids[17],'') in k[ids[17]].canonical ? 1 : 0) + (a.get(ids[18],'') in k[ids[18]].canonical ? 1 : 0) + (a.get(ids[19],'') in k[ids[19]].canonical ? 1 : 0) + (a.get(ids[20],'') in k[ids[20]].canonical ? 1 : 0) + (a.get(ids[21],'') in k[ids[21]].canonical ? 1 : 0) + (a.get(ids[22],'') in k[ids[22]].canonical ? 1 : 0) + (a.get(ids[23],'') in k[ids[23]].canonical ? 1 : 0) + (a.get(ids[24],'') in k[ids[24]].canonical ? 1 : 0) + (a.get(ids[25],'') in k[ids[25]].canonical ? 1 : 0) + (a.get(ids[26],'') in k[ids[26]].canonical ? 1 : 0) + (a.get(ids[27],'') in k[ids[27]].canonical ? 1 : 0) + (ids.size()>28 && a.get(ids[28],'') in k[ids[28]].canonical ? 1 : 0) + (ids.size()>29 && a.get(ids[29],'') in k[ids[29]].canonical ? 1 : 0);
    }
    function legacyTwelve(a,b,k) { return (a.get(b.questions[0].id,-1)==k[b.questions[0].id]?1:0) + (a.get(b.questions[1].id,-1)==k[b.questions[1].id]?1:0) + (a.get(b.questions[2].id,-1)==k[b.questions[2].id]?1:0) + (a.get(b.questions[3].id,-1)==k[b.questions[3].id]?1:0) + (a.get(b.questions[4].id,-1)==k[b.questions[4].id]?1:0) + (a.get(b.questions[5].id,-1)==k[b.questions[5].id]?1:0) + (a.get(b.questions[6].id,-1)==k[b.questions[6].id]?1:0) + (a.get(b.questions[7].id,-1)==k[b.questions[7].id]?1:0) + (a.get(b.questions[8].id,-1)==k[b.questions[8].id]?1:0) + (a.get(b.questions[9].id,-1)==k[b.questions[9].id]?1:0) + (a.get(b.questions[10].id,-1)==k[b.questions[10].id]?1:0) + (a.get(b.questions[11].id,-1)==k[b.questions[11].id]?1:0); }
    function automaticCount(uid,stage) {
      let a=get(attemptDoc(uid,stage)).data;
      return a.get('bankSchema',1)==3 ?
        (get(dynamicBank(a.version)).data.questionIds.size() in [43,44] ? get(dynamicBank(a.version)).data.questionIds.size()-a.answers.diff(get(dynamicKey(a.version)).data.canonicalAnswers).affectedKeys().size() : automaticThirty(a.answers,get(dynamicBank(a.version)).data,get(dynamicKey(a.version)).data.keys)) :
        legacyTwelve(a.answers,get(stageBank(stage)).data,get(stageKey(stage)).data.keys);
    }
    match /expalsa_calidad_autocalificaciones/{uid}/etapas/{stage} {
      allow get: if automaticReader(uid);
      allow list: if expalsaAdmin();
      allow create: if automaticReader(uid) && closedForScoring(uid,stage) &&
        request.resource.data.keys().hasOnly(['uid','stage','correctCount','total','gradedAt']) &&
        request.resource.data.keys().hasAll(['uid','stage','correctCount','total','gradedAt']) &&
        request.resource.data.uid==uid && validStage(stage,request.resource.data.stage) &&
        request.resource.data.correctCount is int &&
        request.resource.data.correctCount>=0 &&
        request.resource.data.total==automaticTotal(uid,stage) &&
        request.resource.data.correctCount<=request.resource.data.total &&
        request.resource.data.gradedAt==request.time &&
        
        
        
        (expalsaAdmin() ||
          request.resource.data.correctCount==automaticCount(uid,stage));
      allow update,delete: if false;
    }
    match /expalsa_calidad_puntuacion/{uid}/etapas/{stage}/comprobaciones/{count} {
      allow get: if automaticReader(uid) && count.matches('^(0|[1-3]?[0-9]|4[0-3])$') &&
        closedForScoring(uid,stage) && int(count)<=automaticCount(uid,stage);
      allow list,create,update,delete: if false;
    }

    match /expalsa_calidad_config/{id} {
      allow get: if (id=='administrador' && expalsaAdmin()) || (id=='evaluaciones' && (expalsaAdmin() || inspector()));
      allow create,update: if id=='evaluaciones' && expalsaAdmin() && configurationValid(request.resource.data);
      allow list,delete: if false;
    }
    
    function accessDataValid(d) {
      return d.keys().hasOnly(['email','active','role','note','deleted','deletedAt','deletedBy']) &&
        d.keys().hasAll(['email','active','role']) &&
        d.email is string && d.email.matches('^[^@]+@[^@]+$') &&
        d.active is bool && d.role=='inspector' &&
        (!d.keys().hasAny(['deleted']) || d.deleted is bool) &&
        (!d.keys().hasAny(['deletedAt']) || d.deletedAt is timestamp) &&
        (!d.keys().hasAny(['deletedBy']) || d.deletedBy is string) &&
        (d.get('deleted',false)!=true ||
          (d.active==false && d.keys().hasAll(['deletedAt','deletedBy'])));
    }
    function newDeletionAudited(d) {
      return resource.data.get('deleted',false)==true || d.get('deleted',false)!=true ||
        (d.deletedAt==request.time && d.deletedBy==request.auth.uid);
    }
    match /expalsa_calidad_accesos/{uid} {
      allow get: if expalsaAdmin() || (signedIn() && request.auth.uid==uid);
      allow list: if expalsaAdmin();
      allow create: if expalsaAdmin() && accessDataValid(request.resource.data) && request.resource.data.get('deleted',false)!=true;
      allow update: if expalsaAdmin() && accessDataValid(request.resource.data) && newDeletionAudited(request.resource.data);
      allow delete: if false; 
    }

    
    function jpegValid(d) {
      return d.jpeg is string && d.jpeg.size()>4 && d.jpeg.size()<=280000 && d.jpeg.matches('^/9j/[A-Za-z0-9+/=]+$') &&
        d.width is int && d.width>0 && d.width<=1600 && d.height is int && d.height>0 && d.height<=1600 &&
        d.size is int && d.size>0 && d.size<=210000;
    }
    function photoDataValid(uid,d) {
      return d.keys().hasOnly(['uid','path','origin','uploadedBy','updatedAt','storage','jpeg','width','height','size']) &&
        d.keys().hasAll(['uid','path','origin','uploadedBy','updatedAt']) &&
        d.uid==uid && d.path=='expalsa_calidad_fotos/'+uid+'/perfil.jpg' &&
        ((!d.keys().hasAny(['storage','jpeg','width','height','size'])) || (d.storage=='firestore' && jpegValid(d))) &&
        d.origin in ['camera','gallery'] && d.updatedAt==request.time &&
        ((d.origin=='camera' && inspector() && request.auth.uid==uid && d.uploadedBy==uid) ||
         (expalsaAdmin() && exists(accessDoc(uid)) && get(accessDoc(uid)).data.active==true &&
          get(accessDoc(uid)).data.get('deleted',false)!=true && d.uploadedBy==request.auth.uid));
    }
    match /expalsa_calidad_evidencias/{id} {
      allow get,list: if expalsaAdmin();
      allow create: if expalsaAdmin() && id.matches('^IMG-[A-Za-z0-9-]{8,80}$') &&
        request.resource.data.keys().hasOnly(['uid','recordId','kind','jpeg','width','height','size','origin','createdBy','createdAt']) &&
        (activeTarget(request.resource.data.uid) || request.resource.data.uid==request.auth.uid) &&
        shortText(request.resource.data.recordId,1,180) &&
        request.resource.data.kind in ['arranque','monitoreo','bpm','palas','escalamiento','observaciones','capacitacion','formacion','gestion','diario','acompanamiento'] &&
        request.resource.data.origin in ['camera','gallery'] && jpegValid(request.resource.data) &&
        request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
      allow update,delete: if false;
    }
    match /expalsa_calidad_fotos_perfil/{uid} {
      allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
      allow list: if expalsaAdmin();
      allow create: if photoDataValid(uid,request.resource.data);
      allow update: if photoDataValid(uid,request.resource.data) &&
        request.resource.data.uid==resource.data.uid &&
        request.resource.data.path==resource.data.path;
      allow delete: if false;
    }
    match /expalsa_calidad_solicitudes/{uid} {
      allow get: if expalsaAdmin() || (accountEmail() && request.auth.uid==uid);
      allow list: if expalsaAdmin();
      allow create: if accountEmail() && request.auth.uid==uid &&
        (!exists(accessDoc(uid)) || get(accessDoc(uid)).data.get('deleted',false)!=true) && request.resource.data.keys().hasOnly(['email','status','createdAt']) &&
        request.resource.data.keys().hasAll(['email','status','createdAt']) && request.resource.data.email==request.auth.token.email &&
        request.resource.data.status=='pending' && request.resource.data.createdAt==request.time;
      allow update,delete: if expalsaAdmin();
    }
    match /expalsa_calidad_perfiles/{id} {
      allow get, list: if expalsaAdmin();
      allow create: if expalsaAdmin() && request.resource.data.payload is map && request.resource.data.payload.id==id && request.resource.data.updatedBy==request.auth.token.email;
      allow update: if expalsaAdmin() && request.resource.data.payload is map && request.resource.data.payload.id==id && request.resource.data.updatedBy==request.auth.token.email &&
        request.resource.data.payload.get('accountUid','')==resource.data.payload.get('accountUid','') &&
        (request.resource.data.payload.get('training',[])==resource.data.payload.get('training',[]) || trainingStageValid(request.resource.data.payload,resource.data.payload));
      allow delete: if false;
    }
    match /expalsa_calidad_registros/{id} {
      allow get, list: if expalsaAdmin();
      allow create: if expalsaAdmin() && rawRecordValid(id,request.resource.data);
      allow update: if expalsaAdmin() && rawRecordValid(id,request.resource.data) && request.resource.data.kind==resource.data.kind &&
        request.resource.data.payload.profileId==resource.data.payload.profileId && evaluationStage(request.resource.data.payload)==evaluationStage(resource.data.payload);
      allow delete: if false;
    }

    function rawRecordValid(id,d) {
      return d.payload is map && d.payload.id==id && d.kind in ['observaciones','arranque','monitoreo','bpm','palas','escalamiento','gestion','capacitacion'] &&
        d.updatedBy==request.auth.token.email && (d.kind=='gestion' || rawRecordStage(d));
    }
    function identityDoc(uid) { return /databases/$(database)/documents/expalsa_calidad_identidades/$(uid); }
    function activeTarget(uid) {
      let access=get(accessDoc(uid)).data;
      return access.active==true && access.get('deleted',false)!=true;
    }
    function identityDataValid(uid,d) {
      return d.keys().hasOnly(['uid','email','firstNames','lastNames','employeeId','createdAt','updatedAt']) &&
        d.keys().hasAll(['uid','email','firstNames','lastNames','employeeId','createdAt','updatedAt']) &&
        d.uid==uid && d.email==get(accessDoc(uid)).data.email &&
        d.firstNames is string && d.firstNames.size()>=2 && d.firstNames.size()<=100 &&
        d.lastNames is string && d.lastNames.size()>=2 && d.lastNames.size()<=100 &&
        d.employeeId is string && d.employeeId.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$') &&
        d.createdAt is timestamp && d.updatedAt==request.time;
    }
    function identityPresent(uid) { return get(identityDoc(uid)).data.uid==uid; }
    match /expalsa_calidad_identidades/{uid} {
      allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
      allow list: if expalsaAdmin();
      allow create: if (expalsaAdmin() || (inspector() && request.auth.uid==uid)) && activeTarget(uid) &&
        identityDataValid(uid,request.resource.data) && request.resource.data.createdAt==request.time;
      allow update: if expalsaAdmin() && identityDataValid(uid,request.resource.data) &&
        request.resource.data.createdAt==resource.data.createdAt && request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email;
      allow delete: if false;
    }
    function radarScore(n) { return n==null || (n>=0 && n<=100); }
    function radarMean(t,p,m) {
      return ((t==null || p==null) && m==null) ||
        (t is number && p is number && m is number && m>=(t+p)*0.5-0.0000001 && m<=(t+p)*0.5+0.0000001);
    }

    function radarTopics(uid,d) {
      return d.keys().hasOnly(['schema','uid','asOf','practice','theory','average','delta','paired','covered','practicalAxes','theoreticalAxes','updatedBy','updatedAt']) && d.size()==13 && d.schema==3 && d.uid==uid && d.asOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && radarScore(d.practice) && radarScore(d.theory) && radarScore(d.average) && radarMean(d.practice,d.theory,d.average) && d.delta==null && d.paired==0 && d.covered is int && d.covered>=0 && d.covered<=9 && d.practicalAxes is map && d.practicalAxes.size()==9 && d.practicalAxes.keys().hasOnly(['cuenta', 'bruto', 'neto', 'uniformidad', 'calidad', 'ordenes', 'registros', 'organolepticos', 'sulfitos']) && radarScore(d.practicalAxes.cuenta) && radarScore(d.practicalAxes.bruto) && radarScore(d.practicalAxes.neto) && radarScore(d.practicalAxes.uniformidad) && radarScore(d.practicalAxes.calidad) && radarScore(d.practicalAxes.ordenes) && radarScore(d.practicalAxes.registros) && radarScore(d.practicalAxes.organolepticos) && radarScore(d.practicalAxes.sulfitos) && d.theoreticalAxes is map && d.theoreticalAxes.size()==11 && d.theoreticalAxes.keys().hasOnly(['certificaciones', 'piezas', 'calculoscuenta', 'glaseo', 'uniformidad', 'cuenta', 'peso', 'calidad', 'temperatura', 'sulfitos', 'codex']) && radarScore(d.theoreticalAxes.certificaciones) && radarScore(d.theoreticalAxes.piezas) && radarScore(d.theoreticalAxes.calculoscuenta) && radarScore(d.theoreticalAxes.glaseo) && radarScore(d.theoreticalAxes.uniformidad) && radarScore(d.theoreticalAxes.cuenta) && radarScore(d.theoreticalAxes.peso) && radarScore(d.theoreticalAxes.calidad) && radarScore(d.theoreticalAxes.temperatura) && radarScore(d.theoreticalAxes.sulfitos) && radarScore(d.theoreticalAxes.codex) && d.updatedBy==request.auth.uid && d.updatedAt==request.time;
    }
    function radarTraining(uid,d) {
