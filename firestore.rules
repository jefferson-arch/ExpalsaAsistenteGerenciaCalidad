      allow update: if expalsaAdmin() && identityDataValid(uid,request.resource.data) &&
        request.resource.data.createdAt==resource.data.createdAt && request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email;
      allow delete: if false;
    }
    function radarScore(n) { return n==null || (n>=0 && n<=100); }
    function radarMean(t,p,m) {
      return ((t==null || p==null) && m==null) ||
        (t is number && p is number && m is number && m>=(t+p)*0.5-0.0000001 && m<=(t+p)*0.5+0.0000001);
    }

    function radarTopics(uid,d) {
      return d.keys().hasOnly(['schema','uid','asOf','practice','theory','average','delta','paired','covered','practicalAxes','theoreticalAxes','updatedBy','updatedAt']) && d.size()==13 && d.schema==3 && d.uid==uid && d.asOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && radarScore(d.practice) && radarScore(d.theory) && radarScore(d.average) && radarMean(d.practice,d.theory,d.average) && d.delta==null && d.paired==0 && d.covered is int && d.covered>=0 && d.covered<=9 && d.practicalAxes is map && d.practicalAxes.size()==9 && d.practicalAxes.keys().hasOnly(['cuenta', 'bruto', 'neto', 'uniformidad', 'calidad', 'ordenes', 'registros', 'organolepticos', 'sulfitos']) && radarScore(d.practicalAxes.cuenta) && radarScore(d.practicalAxes.bruto) && radarScore(d.practicalAxes.neto) && radarScore(d.practicalAxes.uniformidad) && radarScore(d.practicalAxes.calidad) && radarScore(d.practicalAxes.ordenes) && radarScore(d.practicalAxes.registros) && radarScore(d.practicalAxes.organolepticos) && radarScore(d.practicalAxes.sulfitos) && d.theoreticalAxes is map && d.theoreticalAxes.size()==11 && d.theoreticalAxes.keys().hasOnly(['certificaciones', 'piezas', 'calculoscuenta', 'glaseo', 'uniformidad', 'cuenta', 'peso', 'calidad', 'temperatura', 'sulfitos', 'codex']) && radarScore(d.theoreticalAxes.certificaciones) && radarScore(d.theoreticalAxes.piezas) && radarScore(d.theoreticalAxes.calculoscuenta) && radarScore(d.theoreticalAxes.glaseo) && radarScore(d.theoreticalAxes.uniformidad) && radarScore(d.theoreticalAxes.cuenta) && radarScore(d.theoreticalAxes.peso) && radarScore(d.theoreticalAxes.calidad) && radarScore(d.theoreticalAxes.temperatura) && radarScore(d.theoreticalAxes.sulfitos) && radarScore(d.theoreticalAxes.codex) && d.updatedBy==request.auth.uid && d.updatedAt==request.time;
    }
    function radarOperational(uid,d) {
      return d.keys().hasOnly(['schema','uid','asOf','practice','theory','average','delta','paired','covered','competencies','technical','updatedBy','updatedAt']) && d.size()==13 && d.schema==2 && d.uid==uid && d.asOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && radarScore(d.practice) && radarScore(d.theory) && radarScore(d.average) && radarMean(d.practice,d.theory,d.average) && d.delta==null && d.paired==0 && d.covered is int && d.covered>=0 && d.covered<=13 && d.competencies is map && d.competencies.size()==39 && d.competencies.keys().hasOnly(['P1_practice', 'P1_theory', 'P1_average', 'P2_practice', 'P2_theory', 'P2_average', 'P3_practice', 'P3_theory', 'P3_average', 'P4_practice', 'P4_theory', 'P4_average', 'P5_practice', 'P5_theory', 'P5_average', 'P6_practice', 'P6_theory', 'P6_average', 'P7_practice', 'P7_theory', 'P7_average', 'P8_practice', 'P8_theory', 'P8_average', 'P9_practice', 'P9_theory', 'P9_average', 'P10_practice', 'P10_theory', 'P10_average', 'P11_practice', 'P11_theory', 'P11_average', 'P12_practice', 'P12_theory', 'P12_average', 'P13_practice', 'P13_theory', 'P13_average']) && radarScore(d.competencies.P1_practice) && radarScore(d.competencies.P1_theory) && radarScore(d.competencies.P1_average) && radarScore(d.competencies.P2_practice) && radarScore(d.competencies.P2_theory) && radarScore(d.competencies.P2_average) && radarScore(d.competencies.P3_practice) && radarScore(d.competencies.P3_theory) && radarScore(d.competencies.P3_average) && radarScore(d.competencies.P4_practice) && radarScore(d.competencies.P4_theory) && radarScore(d.competencies.P4_average) && radarScore(d.competencies.P5_practice) && radarScore(d.competencies.P5_theory) && radarScore(d.competencies.P5_average) && radarScore(d.competencies.P6_practice) && radarScore(d.competencies.P6_theory) && radarScore(d.competencies.P6_average) && radarScore(d.competencies.P7_practice) && radarScore(d.competencies.P7_theory) && radarScore(d.competencies.P7_average) && radarScore(d.competencies.P8_practice) && radarScore(d.competencies.P8_theory) && radarScore(d.competencies.P8_average) && radarScore(d.competencies.P9_practice) && radarScore(d.competencies.P9_theory) && radarScore(d.competencies.P9_average) && radarScore(d.competencies.P10_practice) && radarScore(d.competencies.P10_theory) && radarScore(d.competencies.P10_average) && radarScore(d.competencies.P11_practice) && radarScore(d.competencies.P11_theory) && radarScore(d.competencies.P11_average) && radarScore(d.competencies.P12_practice) && radarScore(d.competencies.P12_theory) && radarScore(d.competencies.P12_average) && radarScore(d.competencies.P13_practice) && radarScore(d.competencies.P13_theory) && radarScore(d.competencies.P13_average) && d.technical is map && d.technical.size()==10 && d.technical.keys().hasOnly(['C1','C2','C3','C4','C5','C6','C7','C8','C9','C10']) && radarScore(d.technical.C1) && radarScore(d.technical.C2) && radarScore(d.technical.C3) && radarScore(d.technical.C4) && radarScore(d.technical.C5) && radarScore(d.technical.C6) && radarScore(d.technical.C7) && radarScore(d.technical.C8) && radarScore(d.technical.C9) && radarScore(d.technical.C10) && d.updatedBy==request.auth.uid && d.updatedAt==request.time;
    }

    function radarData(uid,d) {
      let c=d.competencies;
      let t=d.technical;
      return d.keys().hasOnly(['schema','uid','asOf','practice','theory','average','delta','paired','covered','competencies','technical','updatedBy','updatedAt']) && d.size()==13 &&
        d.schema==1 && d.uid==uid && d.asOf is string && d.asOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        radarScore(d.practice) && radarScore(d.theory) && radarScore(d.average) &&
        radarMean(d.practice,d.theory,d.average) &&
        (d.delta==null || (d.delta is number && d.delta>=-100 && d.delta<=100)) && d.paired is int && d.paired>=0 && d.paired<=10 && d.covered is int && d.covered>=0 && d.covered<=10 &&
        c.size()==30 && c.keys().hasOnly(['C1_theory','C1_practice','C1_average','C2_theory','C2_practice','C2_average','C3_theory','C3_practice','C3_average','C4_theory','C4_practice','C4_average','C5_theory','C5_practice','C5_average','C6_theory','C6_practice','C6_average','C7_theory','C7_practice','C7_average','C8_theory','C8_practice','C8_average','C9_theory','C9_practice','C9_average','C10_theory','C10_practice','C10_average']) &&
        radarScore(c.C1_theory) && c.C1_practice in [null,0,25,50,75,100] && radarScore(c.C1_average) &&
        radarScore(c.C2_theory) && c.C2_practice in [null,0,25,50,75,100] && radarScore(c.C2_average) &&
        radarScore(c.C3_theory) && c.C3_practice in [null,0,25,50,75,100] && radarScore(c.C3_average) &&
        radarScore(c.C4_theory) && c.C4_practice in [null,0,25,50,75,100] && radarScore(c.C4_average) &&
        radarScore(c.C5_theory) && c.C5_practice in [null,0,25,50,75,100] && radarScore(c.C5_average) &&
        radarScore(c.C6_theory) && c.C6_practice in [null,0,25,50,75,100] && radarScore(c.C6_average) &&
        radarScore(c.C7_theory) && c.C7_practice in [null,0,25,50,75,100] && radarScore(c.C7_average) &&
        radarScore(c.C8_theory) && c.C8_practice in [null,0,25,50,75,100] && radarScore(c.C8_average) &&
        radarScore(c.C9_theory) && c.C9_practice in [null,0,25,50,75,100] && radarScore(c.C9_average) &&
        radarScore(c.C10_theory) && c.C10_practice in [null,0,25,50,75,100] && radarScore(c.C10_average) &&
        t is map && t.size()==7 && t.keys().hasOnly(['temperature','sensory','weight','glaze','sulfites','defects','sampling']) &&
        t.temperature in [null,0,25,50,75,100] && t.sensory in [null,0,25,50,75,100] && t.weight in [null,0,25,50,75,100] && t.glaze in [null,0,25,50,75,100] &&
        t.sulfites in [null,0,25,50,75,100] && t.defects in [null,0,25,50,75,100] && t.sampling in [null,0,25,50,75,100] &&
        d.updatedBy==request.auth.uid && d.updatedAt==request.time;
    }
    match /expalsa_calidad_radares/{uid} {
      allow get: if expalsaAdmin() || (inspector() && request.auth.uid==uid);
      allow list: if expalsaAdmin();
      allow create,update: if expalsaAdmin() && activeTarget(uid) && (request.resource.data.schema==3?radarTopics(uid,request.resource.data):request.resource.data.schema==2?radarOperational(uid,request.resource.data):radarData(uid,request.resource.data));
      allow delete: if false;
    }

    function dailyDoc(id) { return /databases/$(database)/documents/expalsa_calidad_diario/$(id); }
    function shortText(v,min,max) { return v is string && v.size()>=min && v.size()<=max; }
    function calendarKey(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function criteriaKeys(v) { return v is map && v.keys().hasOnly(['C1','C2','C3','C4','C5','C6','C7','C8','C9','C10']) && v.size()==10; }
    function dailyPoint(level,e) {
      return e is string && e.size()<=1000 && (level==-1 || e.size()>=20);
    }
    function technicalControl(c) {
      return c.level in [0,1,2,3,4] && c.autonomous is bool;
    }
    function technicalValid(t,strict) {
      return t==null || (t is map && t.keys().hasOnly(['version','product','destination','specification','controls']) && t.version==1 &&
        shortText(t.product,2,160) && shortText(t.destination,2,160) && shortText(t.specification,2,160) &&
        t.controls is map && t.controls.size()>0 && t.controls.keys().hasOnly(['temperature','sensory','weight','glaze','sulfites','defects','sampling']) &&
        (!strict || ((!('temperature' in t.controls) || technicalControl(t.controls.temperature)) && (!('sensory' in t.controls) || technicalControl(t.controls.sensory)) &&
        (!('weight' in t.controls) || technicalControl(t.controls.weight)) && (!('glaze' in t.controls) || technicalControl(t.controls.glaze)) &&
        (!('sulfites' in t.controls) || technicalControl(t.controls.sulfites)) && (!('defects' in t.controls) || technicalControl(t.controls.defects)) &&
        (!('sampling' in t.controls) || technicalControl(t.controls.sampling)))));
    }
    function dailyDataValid(d) {
      let levels=d.ratings;
      let proof=d.evidence;
      return d.keys().hasOnly(['uid','date','area','shift','lot','activity','finding','observation','critical','containment','ratings','evidence','autonomy','createdBy','createdAt','photoIds','sourceId','sourceKind','sourceProfileId','sourceRevision','updatedAt','voided','technical','evaluationStage']) &&
        d.uid is string && activeTarget(d.uid) && identityPresent(d.uid) && photoPresent(d.uid) && calendarKey(d.date) &&
        shortText(d.area,1,160) && shortText(d.shift,1,160) && shortText(d.lot,1,160) && shortText(d.activity,1,160) &&
        d.finding in ['Fortaleza','Oportunidad de mejora','Incidencia crítica','Condición del proceso'] &&
        shortText(d.observation,12,2000) && d.critical is bool && d.critical==(d.finding=='Incidencia crítica') && shortText(d.containment,d.critical?12:0,2000) &&
        criteriaKeys(d.ratings) && criteriaKeys(d.evidence) && criteriaKeys(d.autonomy) &&
        d.ratings.values().hasOnly([-1,0,1,2,3,4]) && d.ratings.values().hasAny([0,1,2,3,4]) && d.autonomy.values().hasOnly([true,false]) &&
        (d.get('technical',null)!=null || (dailyPoint(levels.C1,proof.C1) && dailyPoint(levels.C2,proof.C2) && dailyPoint(levels.C3,proof.C3) && dailyPoint(levels.C4,proof.C4) && dailyPoint(levels.C5,proof.C5) &&
        dailyPoint(levels.C6,proof.C6) && dailyPoint(levels.C7,proof.C7) && dailyPoint(levels.C8,proof.C8) && dailyPoint(levels.C9,proof.C9) && dailyPoint(levels.C10,proof.C10))) &&
        d.createdAt is timestamp && d.createdBy==request.auth.uid && photoIdsValid(d.get('photoIds',[])) && technicalValid(d.get('technical',null),true);
    }
    function photoIdsValid(ids) { return ids is list && ids.size()<=4; }
    function linkedFieldValid(id,d) {
      let profile=getAfter(/databases/$(database)/documents/expalsa_calidad_perfiles/$(d.sourceProfileId)).data.payload;
      let source=d.sourceKind=='formacion'?{}:getAfter(/databases/$(database)/documents/expalsa_calidad_registros/$(d.sourceId)).data;
      return d.uid==profile.accountUid && (d.sourceKind=='formacion' || evaluationStage(d)==evaluationStage(source.payload)) && d.sourceRevision is int && d.sourceRevision>0 && d.voided is bool && d.updatedAt==request.time &&
        (d.sourceKind=='formacion' ? id=='REF-'+d.sourceId :
